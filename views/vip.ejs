<%- include('partials/header') %>

<div class="container mx-auto px-4 py-10 max-w-4xl">
    <!-- Top Cyberpunk Hero Header -->
    <div class="text-center relative mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-400/40 text-amber-300 text-xs font-black uppercase tracking-widest mb-3 shadow-[0_0_15px_rgba(245,158,11,0.2)]">
            <i class="fas fa-crown text-amber-400"></i> Elite Membership
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-white tracking-wider uppercase font-primary">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-500">ZERO VIP PASS</span>
        </h1>
        <p class="text-slate-400 text-sm mt-2 max-w-xl mx-auto">
            আনলক করুন সর্বোচ্চ ১০% ফ্ল্যাট ডিসকাউন্ট, এক্সক্লুসিভ গোল্ডেন ব্যাজ এবং ইনস্ট্যান্ট প্রায়োরিটি সাপোর্ট।
        </p>
    </div>

    <!-- VIP Status Card -->
    <div class="bg-gradient-to-b from-[#111827] to-[#0b0f19] border border-amber-500/30 rounded-3xl p-6 sm:p-10 mb-10 shadow-[0_10px_40px_rgba(245,158,11,0.12)] relative overflow-hidden">
        <!-- Background Ambient Glow -->
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-6 relative z-10">
            <div class="flex items-center gap-5">
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-amber-400 to-yellow-600 flex items-center justify-center text-4xl text-black shadow-[0_0_30px_rgba(245,158,11,0.5)] shrink-0">
                    <i class="fas fa-crown"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-2xl font-black text-white"><%= vipSettings.title || 'ZERO VIP PASS' %></h2>
                        <% if (isVip) { %>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 animate-pulse">
                                Active (<%= daysRemaining %> Days Left)
                            </span>
                        <% } else { %>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-slate-800 text-slate-400 border border-slate-700">
                                Inactive
                            </span>
                        <% } %>
                    </div>
                    <p class="text-xs text-slate-400 mt-1">
                        <% if (isVip) { %>
                            আপনার VIP মেম্বারশিপ সক্রিয় রয়েছে। মেম্বারশিপ শেষ হতে আরও <%= daysRemaining %> দিন বাকি।
                        <% } else { %>
                            মাত্র <%= vipSettings.price %>৳ তে ৩০ দিনের জন্য সকল প্রিমিয়াম সুবিধা উপভোগ করুন।
                        <% } %>
                    </p>
                </div>
            </div>

            <!-- Price & Action Button -->
            <div class="text-center md:text-right w-full md:w-auto shrink-0">
                <div class="text-3xl font-black text-amber-400 font-mono tracking-tight mb-2">
                    <%= vipSettings.price %>৳ <span class="text-xs text-slate-400 font-normal">/ <%= vipSettings.duration_days %> দিন</span>
                </div>
                <% if (currentUser) { %>
                    <button type="button" onclick="buyVipPass()" id="btnBuyVip"
                        class="w-full md:w-auto px-8 py-3 rounded-xl font-black text-sm text-black bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-500 hover:from-amber-200 hover:to-yellow-400 active:scale-95 transition shadow-[0_0_25px_rgba(245,158,11,0.4)] flex items-center justify-center gap-2 mx-auto md:ml-auto">
                        <i class="fas fa-bolt"></i>
                        <span id="btnBuyVipText"><%= isVip ? 'Extend VIP Pass (+30 Days)' : 'Upgrade to VIP Now' %></span>
                    </button>
                <% } else { %>
                    <a href="/login?returnUrl=/vip" 
                        class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl font-black text-sm text-black bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-500 hover:from-amber-200 hover:to-yellow-400 transition shadow-[0_0_25px_rgba(245,158,11,0.4)] no-underline">
                        <i class="fas fa-sign-in-alt"></i> Login to Upgrade
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- VIP Perks Grid -->
    <div class="mb-12">
        <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
            <i class="fas fa-gem text-amber-400"></i> VIP মেম্বারশিপের এক্সক্লুসিভ সুবিধাসমূহ
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="bg-[#0f172a] border border-slate-800 hover:border-amber-500/50 rounded-2xl p-6 transition duration-300 group">
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                    <i class="fas fa-percent"></i>
                </div>
                <h4 class="text-base font-bold text-white mb-1.5">১০% ফ্ল্যাট ডিসকাউন্ট</h4>
                <p class="text-xs text-slate-400 leading-relaxed">
                    সাইটের যেকোনো প্যানেল ও কি অর্ডারে স্বয়ংক্রিয়ভাবে সরাসরি ১০% ছাড় পাবেন। কোনো কুপন কোড প্রয়োজন নেই!
                </p>
            </div>

            <div class="bg-[#0f172a] border border-slate-800 hover:border-amber-500/50 rounded-2xl p-6 transition duration-300 group">
                <div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                    <i class="fas fa-shield-halved"></i>
                </div>
                <h4 class="text-base font-bold text-white mb-1.5">অগ্রাধিকার HWID সাপোর্ট</h4>
                <p class="text-xs text-slate-400 leading-relaxed">
                    ডিভাইস চেঞ্জ বা রিসেট রিকোয়েস্ট কোনো ঝামেলা ছাড়াই সুপার-ফাস্ট প্রায়োরিটিতে সম্পন্ন করা হবে।
                </p>
            </div>

            <div class="bg-[#0f172a] border border-slate-800 hover:border-amber-500/50 rounded-2xl p-6 transition duration-300 group">
                <div class="w-12 h-12 rounded-xl bg-pink-500/10 text-pink-400 flex items-center justify-center text-xl mb-4 group-hover:scale-110 transition">
                    <i class="fas fa-box-open"></i>
                </div>
                <h4 class="text-base font-bold text-white mb-1.5">মিস্ট্রি বক্স লাকি বুস্ট</h4>
                <p class="text-xs text-slate-400 leading-relaxed">
                    সাইবার মিস্ট্রি বক্স খোলার সময় VIP মেম্বাররা অতিরিক্ত লাকি ড্রপ চান্স ও এক্সক্লুসিভ রিওয়ার্ড বোনাস উপভোগ করবেন।
                </p>
            </div>
        </div>
    </div>

    <!-- Comparison Table: Regular vs VIP -->
    <div class="bg-[#0f172a] border border-slate-800 rounded-2xl p-6 overflow-hidden">
        <h3 class="text-lg font-bold text-white mb-4">সাধারণ ইউজার বনাম ভিআইপি সদস্য</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="border-b border-slate-800 text-slate-400 font-bold uppercase tracking-wider">
                        <th class="py-3 px-4">সুবিধা (Features)</th>
                        <th class="py-3 px-4 text-center">সাধারণ ইউজার</th>
                        <th class="py-3 px-4 text-center text-amber-400 font-black">👑 ZERO VIP মেম্বার</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/60 text-slate-300">
                    <tr>
                        <td class="py-3.5 px-4 font-semibold text-white">প্রোডাক্ট ডিসকাউন্ট</td>
                        <td class="py-3.5 px-4 text-center text-slate-500">০% (নরমাল প্রাইস)</td>
                        <td class="py-3.5 px-4 text-center font-bold text-emerald-400">১০% প্রতি অর্ডারে সেভ!</td>
                    </tr>
                    <tr>
                        <td class="py-3.5 px-4 font-semibold text-white">প্রোফাইল স্টাইল</td>
                        <td class="py-3.5 px-4 text-center text-slate-500">রেগুলার ব্যাজ</td>
                        <td class="py-3.5 px-4 text-center font-bold text-amber-400">গোল্ডেন ক্রাউন 👑 ভিআইপি ব্যাজ</td>
                    </tr>
                    <tr>
                        <td class="py-3.5 px-4 font-semibold text-white">HWID ডিভাইস রিসেট</td>
                        <td class="py-3.5 px-4 text-center text-slate-500">সাধারণ কিউ</td>
                        <td class="py-3.5 px-4 text-center font-bold text-cyan-400">সুপারফাস্ট প্রায়োরিটি</td>
                    </tr>
                    <tr>
                        <td class="py-3.5 px-4 font-semibold text-white">কমিউনিটি রোল</td>
                        <td class="py-3.5 px-4 text-center text-slate-500">মেম্বার</td>
                        <td class="py-3.5 px-4 text-center font-bold text-indigo-400">VIP Exclusive Access</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    async function buyVipPass() {
        if (typeof playCyberSfx === 'function') playCyberSfx('click');
        
        const confirmed = confirm("আপনি কি আপনার ওয়ালেট থেকে <%= vipSettings.price %>৳ দিয়ে ৩০ দিনের ZERO VIP PASS নিতে চান?");
        if (!confirmed) return;

        const btn = document.getElementById('btnBuyVip');
        const btnText = document.getElementById('btnBuyVipText');
        const orig = btnText.innerText;

        btn.disabled = true;
        btnText.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Processing...';

        try {
            const res = await fetch('/api/vip/purchase', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();

            if (!res.ok || !data.success) {
                alert(data.message || 'VIP Pass কেনা সম্ভব হয়নি। ওয়ালেট চেক করুন।');
                if (data.message && data.message.includes('Insufficient')) {
                    if (confirm("আপনার ওয়ালেটে পর্যাপ্ত ব্যালেন্স নেই। এখনই টাকা লোড (Add Funds) করতে চান?")) {
                        window.location.href = '/add-funds';
                    }
                }
                btn.disabled = false;
                btnText.innerText = orig;
                return;
            }

            if (typeof playCyberSfx === 'function') playCyberSfx('success');
            alert(data.message);
            window.location.reload();
        } catch (err) {
            console.error(err);
            alert("সার্ভার এরর হয়েছে। দয়া করে আবার চেষ্টা করুন।");
            btn.disabled = false;
            btnText.innerText = orig;
        }
    }
</script>

<%- include('partials/footer') %>
