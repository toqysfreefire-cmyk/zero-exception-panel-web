                </div>

                <div class="flex items-center gap-2">
                    <a href="<%= (typeof referralSettings !== 'undefined' && referralSettings.discord_invite_url) ? referralSettings.discord_invite_url : 'https://discord.gg/5dVCdvuqm' %>" target="_blank" rel="noopener noreferrer" style="background: #5865F2 !important;" class="px-4 py-2 rounded-xl text-white font-bold text-xs flex items-center gap-2 shadow-lg no-underline hover:scale-105 transition-transform">
                        <i class="fab fa-discord text-base"></i> Refer Discord
                    </a>
                </div>
            </div>

            <!-- Milestone Progress Card -->
            <% 
            const curRefers = (typeof user !== 'undefined' && user.referral_current) ? parseInt(user.referral_current) : 0;
            const targetRefers = 10;
            const pct = Math.min(100, Math.round((curRefers / targetRefers) * 100));
            const remaining = Math.max(0, targetRefers - curRefers);
            %>
            <div class="p-6 rounded-3xl bg-black/60 border border-[#5865F2]/50 mb-8 relative overflow-hidden shadow-xl">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                    <div>
                        <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 font-mono block">CURRENT MILESTONE PROGRESS (বর্তমান মাইলস্টোন)</span>
                        <div class="flex items-baseline gap-2 mt-1">
                            <span class="text-3xl sm:text-4xl font-black font-orbitron text-emerald-400"><%= curRefers %></span>
                            <span class="text-xl font-bold font-orbitron text-gray-400">/ 10</span>
                            <span class="text-xs text-cyan-300 font-mono ml-2">(<%= pct %>% পূর্ণ হয়েছে)</span>
                        </div>
                    </div>

                    <div class="text-left md:text-right">
                        <% if (curRefers >= 10) { %>
                        <span class="px-3 py-1.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs font-bold font-mono">
                            🎉 10৳ Credited to Wallet!
                        </span>
                        <% } else { %>
                        <div class="p-2.5 rounded-xl bg-black/40 border border-cyan-500/30 inline-block">
                            <span class="text-xs text-gray-300 font-mono block">
                                আর মাত্র <b class="text-amber-400 font-bold"><%= remaining %> জন</b> রেফার করলেই <b class="text-emerald-400 font-bold">১০৳</b> ব্যালেন্স পাবেন!
                            </span>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Animated Progress Bar -->
                <div class="w-full h-4 rounded-full bg-[#050b18] border border-white/10 overflow-hidden p-0.5 relative">
                    <div class="h-full rounded-full transition-all duration-700 ease-out" style="width: <%= Math.max(4, pct) %>%; background: linear-gradient(90deg, #5865F2 0%, #06b6d4 50%, #10b981 100%); box-shadow: 0 0 15px rgba(6, 182, 212, 0.6);"></div>
                </div>

                <!-- Progress ticks (0 to 10) -->
                <div class="flex justify-between items-center text-[10px] font-mono text-gray-400 mt-2 px-1">
                    <span>0</span>
                    <span>2</span>
                    <span>4</span>
                    <span>6</span>
                    <span>8</span>
                    <span class="text-emerald-400 font-bold">10 জন (১০৳)</span>
                </div>
            </div>

            <!-- Share & Invite Link Card -->
            <div class="p-6 rounded-2xl bg-black/40 border border-cyan-500/30 mb-8">
                <label class="text-xs font-bold text-cyan-300 uppercase font-mono block mb-2 flex items-center gap-2">
