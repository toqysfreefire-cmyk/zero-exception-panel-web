                                    <span class="flex items-center gap-1.5">
                                        <i class="fas fa-coins text-yellow-400"></i> STORE CURRENCY / অ্যাকাউন্টের কারেন্সি
                                    </span>
                                    <span class="text-[11px] text-yellow-300 font-bold">BDT, USDT অথবা INR</span>
                                </label>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                    <!-- BDT -->
                                    <label class="flex items-center gap-2.5 p-3 rounded-xl border cursor-pointer transition select-none <%= (currentCurrencyCode === 'BDT') ? 'border-emerald-400 bg-emerald-950/40 text-emerald-300 shadow-[0_0_10px_rgba(16,185,129,0.25)]' : 'border-white/15 bg-slate-900/60 text-slate-300 hover:border-emerald-500/50' %>">
                                        <input type="radio" name="currency" value="BDT" <%= (currentCurrencyCode === 'BDT') ? 'checked' : '' %> class="w-4 h-4 accent-emerald-400">
                                        <div>
                                            <div class="font-black text-sm text-white flex items-center gap-1.5">
                                                <span>🇧🇩</span> <span>BDT (৳)</span>
                                            </div>
                                            <div class="text-[10px] text-slate-400 mt-0.5">বাংলাদেশি টাকা</div>
                                        </div>
                                    </label>

                                    <!-- USDT -->
                                    <label class="flex items-center gap-2.5 p-3 rounded-xl border cursor-pointer transition select-none <%= (currentCurrencyCode === 'USDT') ? 'border-cyan-400 bg-cyan-950/40 text-cyan-300 shadow-[0_0_10px_rgba(0,240,255,0.25)]' : 'border-white/15 bg-slate-900/60 text-slate-300 hover:border-cyan-500/50' %>">
                                        <input type="radio" name="currency" value="USDT" <%= (currentCurrencyCode === 'USDT') ? 'checked' : '' %> class="w-4 h-4 accent-cyan-400">
                                        <div>
                                            <div class="font-black text-sm text-white flex items-center gap-1.5">
                                                <span>🇺🇸</span> <span>USDT ($)</span>
                                            </div>
                                            <div class="text-[10px] text-slate-400 mt-0.5">US Dollar / Crypto</div>
                                        </div>
                                    </label>

                                    <!-- INR -->
                                    <label class="flex items-center gap-2.5 p-3 rounded-xl border cursor-pointer transition select-none <%= (currentCurrencyCode === 'INR') ? 'border-amber-400 bg-amber-950/40 text-amber-300 shadow-[0_0_10px_rgba(245,158,11,0.25)]' : 'border-white/15 bg-slate-900/60 text-slate-300 hover:border-amber-500/50' %>">
                                        <input type="radio" name="currency" value="INR" <%= (currentCurrencyCode === 'INR') ? 'checked' : '' %> class="w-4 h-4 accent-amber-400">
                                        <div>
                                            <div class="font-black text-sm text-white flex items-center gap-1.5">
                                                <span>🇮🇳</span> <span>INR (₹)</span>
                                            </div>
                                            <div class="text-[10px] text-slate-400 mt-0.5">Indian Rupee</div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Action Submit Buttons (High Contrast & Crystal Clear Text) -->
                        <div class="pt-6 mt-6 border-t border-white/10 flex flex-col sm:flex-row items-center gap-3">
                            <button type="submit" id="btnSaveProfile" style="background: linear-gradient(135deg, #059669 0%, #0284c7 50%, #2563eb 100%) !important; color: #ffffff !important; font-weight: 900 !important; font-size: 13px !important; text-transform: uppercase; font-family: 'Orbitron', monospace; letter-spacing: 1px; box-shadow: 0 4px 25px rgba(2, 132, 199, 0.6); border: 2px solid #38bdf8; border-radius: 14px; padding: 14px 24px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; transition: all 0.2s;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                                <i class="fas fa-check-circle" style="font-size: 16px; color: #6ee7b7;"></i>
                                <span style="color: #ffffff !important; font-weight: 900;">SAVE CHANGES (পরিবর্তন সেভ করুন)</span>
                            </button>
                            <button type="button" onclick="resetProfileForm()" style="background: rgba(255, 255, 255, 0.12) !important; color: #ffffff !important; border: 1.5px solid rgba(255, 255, 255, 0.3) !important; font-weight: 800; font-size: 12px; text-transform: uppercase; border-radius: 14px; padding: 14px 22px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
                                <i class="fas fa-undo-alt text-xs"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Bottom Account Navigation / Admin / Logout -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-6 mt-8 border-t border-white/10 text-xs">
                <div class="flex items-center gap-3">
                    <% if (user.role === 'admin') { %>
                    <a href="/admin" class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs uppercase tracking-wider rounded-xl transition shadow flex items-center gap-1.5 no-underline">
                        <i class="fas fa-shield-alt"></i> Open Admin Panel
                    </a>
                    <% } %>
                    <a href="/add-funds" class="px-4 py-2 bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 border border-emerald-500/40 font-bold text-xs uppercase tracking-wider rounded-xl transition flex items-center gap-1.5 no-underline">
                        <i class="fas fa-plus-circle"></i> Add Funds / টাকা লোড
                    </a>
                </div>

                <a href="/logout" class="px-4 py-2 bg-red-600/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/40 font-bold text-xs uppercase tracking-wider rounded-xl transition flex items-center gap-1.5 no-underline">
                    <i class="fas fa-power-off"></i> Log Out (লগআউট)
                </a>
            </div>
        </div>
    </div>

    <!-- ============================================================
         TAB 5: DISCORD REFER & EARN (10 Refers -> 10৳ Wallet Reward)
         ============================================================ -->
    <div class="acc-tab-content <%= (activeTab === 'referrals' || activeTab === 'referral') ? 'active' : '' %>" id="tabReferrals">
        <div class="bg-gradient-to-b from-[#0e172e] via-[#091024] to-[#050b18] border-2 border-[#5865F2]/40 rounded-3xl p-6 sm:p-8 shadow-2xl text-white">
            
            <!-- Tab Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-white/10">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase font-mono tracking-wider bg-[#5865F2]/25 text-[#a5b4fc] border border-[#5865F2]/40">
                            COMMUNITY REWARD PROGRAM
                        </span>
                        <span class="text-xs text-gray-400 font-mono">10 Refers = 10৳ Wallet Cash</span>
                    </div>
