                <div class="flex flex-col sm:flex-row gap-2">
                    <input type="text" id="myReferralUrlInput" readonly value="<%= (typeof inviteUrl !== 'undefined' && inviteUrl) ? inviteUrl : 'https://zeroexception.com/invite?ref=REF' + user.id %>" class="flex-1 px-4 py-3 rounded-xl bg-[#060e1f] border border-cyan-500/40 text-cyan-200 font-mono text-xs font-bold outline-none select-all">
                    <button type="button" onclick="copyReferralLink()" style="background: linear-gradient(135deg, #00f0ff, #0284c7) !important;" class="px-6 py-3 rounded-xl text-black font-black font-orbitron text-xs uppercase tracking-wider shadow cursor-pointer flex items-center justify-center gap-2 transition hover:scale-105">
                        <i class="fas fa-copy"></i> <span id="copyRefBtnText">Copy Link</span>
                    </button>
                </div>
                
                <!-- 1-Click Social Share Buttons -->
                <div class="flex flex-wrap items-center gap-2 mt-4 pt-4 border-t border-white/10">
                    <span class="text-[11px] font-mono text-gray-400 mr-2">Share directly:</span>
                    <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent('Join ZERO EXCEPTION Discord Community & Store! ' + ((typeof inviteUrl !== 'undefined') ? inviteUrl : '')) %>" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-emerald-600/30 hover:bg-emerald-600/50 border border-emerald-500/40 text-emerald-300 text-xs font-bold flex items-center gap-1.5 no-underline transition">
                        <i class="fab fa-whatsapp"></i> WhatsApp
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent((typeof inviteUrl !== 'undefined') ? inviteUrl : '') %>" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-blue-600/30 hover:bg-blue-600/50 border border-blue-500/40 text-blue-300 text-xs font-bold flex items-center gap-1.5 no-underline transition">
                        <i class="fab fa-facebook"></i> Facebook
                    </a>
                    <a href="https://t.me/share/url?url=<%= encodeURIComponent((typeof inviteUrl !== 'undefined') ? inviteUrl : '') %>&text=Join+Zero+Exception" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-cyan-600/30 hover:bg-cyan-600/50 border border-cyan-500/40 text-cyan-300 text-xs font-bold flex items-center gap-1.5 no-underline transition">
                        <i class="fab fa-telegram"></i> Telegram
                    </a>
                </div>
            </div>

            <!-- Stats Overview 3-Card Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                <div class="p-4 rounded-2xl bg-black/50 border border-cyan-500/30 text-center">
                    <span class="text-[10px] uppercase font-mono text-gray-400 block mb-1">Current Milestone</span>
                    <strong class="text-2xl font-black font-orbitron text-cyan-400"><%= curRefers %> / 10</strong>
                    <span class="text-[10px] text-gray-400 block mt-1">পূর্ণ হলে রিসেট হয়ে ০/১০ হবে</span>
                </div>
                <div class="p-4 rounded-2xl bg-black/50 border border-emerald-500/30 text-center">
                    <span class="text-[10px] uppercase font-mono text-gray-400 block mb-1">Total Lifetime Refers</span>
                    <strong class="text-2xl font-black font-orbitron text-emerald-400"><%= (typeof user !== 'undefined' && user.referral_total) ? user.referral_total : 0 %></strong>
                    <span class="text-[10px] text-gray-400 block mt-1">সর্বমোট রেফার করা বন্ধু</span>
                </div>
                <div class="p-4 rounded-2xl bg-black/50 border border-amber-500/30 text-center">
                    <span class="text-[10px] uppercase font-mono text-gray-400 block mb-1">Total Earnings</span>
                    <strong class="text-2xl font-black font-orbitron text-amber-400"><%= (typeof user !== 'undefined' && user.referral_earnings) ? user.referral_earnings : 0 %>৳</strong>
                    <span class="text-[10px] text-gray-400 block mt-1">ওয়ালেটে সরাসরি ক্যাশ ক্রেডিট</span>
                </div>
            </div>

            <!-- Referred Members List Table -->
            <div>
                <h3 class="text-sm font-black font-orbitron uppercase text-white tracking-wide mb-3 flex items-center gap-2">
                    <i class="fas fa-users text-cyan-400"></i> My Referred Friends History (<%= (typeof userReferrals !== 'undefined' && userReferrals) ? userReferrals.length : 0 %>)
                </h3>
                <% if (typeof userReferrals !== 'undefined' && userReferrals && userReferrals.length > 0) { %>
                <div class="overflow-x-auto rounded-2xl border border-white/10">
                    <table class="w-full text-left text-xs text-gray-300">
                        <thead class="text-[11px] uppercase bg-black/60 text-gray-400 border-b border-white/10 font-mono">
                            <tr>
                                <th class="p-3">#</th>
                                <th class="p-3">Referred Member</th>
                                <th class="p-3">Joined Date</th>
                                <th class="p-3 text-right">Reward Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 bg-black/30">
                            <% userReferrals.forEach(function(r, idx) { %>
                            <tr class="hover:bg-white/5 transition">
                                <td class="p-3 font-mono text-gray-400"><%= idx + 1 %></td>
                                <td class="p-3 font-bold text-white">
                                    <%= r.referred_user_name || 'Member' %>
                                    <span class="block text-[10px] font-mono text-cyan-400 font-normal"><%= r.referred_user_email || '' %></span>
                                </td>
                                <td class="p-3 font-mono text-gray-400"><%= new Date(r.created_at).toLocaleDateString() %></td>
                                <td class="p-3 text-right">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono <%= r.milestone_awarded ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40' %>">
                                        <%= r.milestone_awarded ? '✓ 10৳ Milestone Paid' : 'Counted (+1)' %>
                                    </span>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="text-center py-8 bg-black/30 rounded-2xl border border-white/5 text-gray-400">
                    <i class="fas fa-user-friends text-3xl mb-2 text-gray-600 block"></i>
                    <p class="text-xs text-gray-300">এখনো কোনো বন্ধু আপনার লিংক দিয়ে জয়েন করেনি। উপরের রেফারেল লিংক কপি করে বন্ধুদের সাথে শেয়ার করুন!</p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<style>
/* Account Tab Navigation Buttons */
.acc-tab-btn {
    padding: 10px 16px;
    border-radius: 12px;
    background: rgba(8, 15, 35, 0.7);
    border: 1.5px solid rgba(0, 240, 255, 0.2);
    color: #94a3b8;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
}
.acc-tab-btn:hover {
    color: #ffffff;
    border-color: #00f0ff;
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
}
.acc-tab-btn.active {
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.25) 0%, rgba(16, 185, 129, 0.25) 100%);
    border-color: #00f0ff;
    color: #ffffff;
    box-shadow: 0 0 16px rgba(0, 240, 255, 0.45);
}

.acc-tab-content {
    display: none;
}
.acc-tab-content.active {
    display: block;
    animation: fadeInTab 0.25s ease;
}

@keyframes fadeInTab {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var tabBtns = document.querySelectorAll('.acc-tab-btn');
    var tabContents = document.querySelectorAll('.acc-tab-content');

    function switchTab(targetId) {
        tabBtns.forEach(function(b) {
            if (b.getAttribute('data-target') === targetId) {
                b.classList.add('active');
            } else {
                b.classList.remove('active');
            }
        });

        tabContents.forEach(function(c) {
            if (c.id === targetId) {
                c.classList.add('active');
            } else {
                c.classList.remove('active');
            }
        });
    }

    // Expose globally
    window.switchTab = switchTab;
    window.switchAccountTab = switchTab;

    tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            var target = this.getAttribute('data-target');
            switchTab(target);
            // Update URL hash without scroll
            if (history.pushState) {
                var hashKey = target.replace('tab', '').toLowerCase();
                history.pushState(null, null, '?tab=' + hashKey);
            }
        });
    });

    // Check URL parameters or hash on load
    var urlParams = new URLSearchParams(window.location.search);
    var tabParam = urlParams.get('tab');
    var hash = window.location.hash.replace('#', '').toLowerCase();
    var activeKey = tabParam || hash;

    if (activeKey === 'keys' || activeKey === 'key') {
        switchTab('tabKeys');
    } else if (activeKey === 'deposits' || activeKey === 'deposit' || activeKey === 'payments') {
        switchTab('tabDeposits');
    } else if (activeKey === 'hwid' || activeKey === 'hwid-reset' || activeKey === 'resets') {
        switchTab('tabHwid');
    } else if (activeKey === 'referrals' || activeKey === 'referral' || activeKey === 'ref') {
        switchTab('tabReferrals');
    } else if (activeKey === 'profile') {
        switchTab('tabProfile');
        if (urlParams.get('saved') === '1') {
            showProfileAlert('প্রোফাইল সফলভাবে আপডেট করা হয়েছে!', true);
        } else if (urlParams.get('error')) {
            showProfileAlert(decodeURIComponent(urlParams.get('error')), false);
        }
    } else if (activeKey === 'orders' || activeKey === 'order') {
        switchTab('tabOrders');
    }
});

function copyReferralLink() {
    var input = document.getElementById('myReferralUrlInput');
    if (!input) return;
    input.select();
    input.setSelectionRange(0, 99999);
    try {
        navigator.clipboard.writeText(input.value);
    } catch(e) {
        document.execCommand('copy');
    }
    var btnText = document.getElementById('copyRefBtnText');
    if (btnText) {
        var orig = btnText.textContent;
        btnText.textContent = '✓ Copied!';
        setTimeout(function() { btnText.textContent = orig; }, 2500);
    }
}

// ============================================================
// PROFILE & AVATAR EDIT CONTROLLER
// ============================================================
function togglePresetGallery() {
    var gallery = document.getElementById('presetAvatarGallery');
    var txt = document.getElementById('togglePresetText');
    if (!gallery) return;
    if (gallery.style.display === 'none' || !gallery.style.display) {
        gallery.style.display = 'block';
        if (txt) txt.textContent = 'Hide Preset Avatars (অ্যাভাটার লুকান)';
    } else {
        gallery.style.display = 'none';
        if (txt) txt.textContent = 'Choose Gaming Preset Avatars (৭টি অ্যাভাটার)';
    }
}

function selectPresetAvatar(avatarUrl, elem) {
    var presetInput = document.getElementById('profileAvatarPresetInput');
    if (presetInput) presetInput.value = avatarUrl;
    
    var preview = document.getElementById('currentAvatarPreview');
    if (preview) {
        preview.src = avatarUrl;
        preview.style.display = 'block';
    }

    // Clear local file input so preset takes priority
    var fileInput = document.getElementById('profileAvatarFileInput');
    if (fileInput) fileInput.value = '';

    // Highlight selected preset
    document.querySelectorAll('.preset-avatar-option').forEach(function(el) {
        el.classList.remove('border-cyan-400', 'ring-2', 'ring-cyan-400');
        el.classList.add('border-white/10');
        var chk = el.querySelector('.preset-check');
        if (chk) {
            chk.style.display = 'none';
            chk.classList.add('hidden');
            chk.classList.remove('flex');
        }
    });

    if (elem) {
        elem.classList.remove('border-white/10');
        elem.classList.add('border-cyan-400', 'ring-2', 'ring-cyan-400');
        var checkEl = elem.querySelector('.preset-check');
        if (checkEl) {
            checkEl.style.display = 'flex';
            checkEl.classList.remove('hidden');
            checkEl.classList.add('flex');
        }
    }
}

// Local File Upload live image reader
var profileFileInput = document.getElementById('profileAvatarFileInput');
if (profileFileInput) {
    profileFileInput.addEventListener('change', function(e) {
        var file = e.target.files && e.target.files[0];
        if (file) {
            if (file.size > 5 * 1024 * 1024) {
                showProfileAlert('Image file size must be less than 5MB.', false);
                profileFileInput.value = '';
                return;
            }
            var reader = new FileReader();
            reader.onload = function(evt) {
                var preview = document.getElementById('currentAvatarPreview');
                if (preview) {
                    preview.src = evt.target.result;
                    preview.style.display = 'block';
                }
                // Clear preset selection
                var presetInput = document.getElementById('profileAvatarPresetInput');
                if (presetInput) presetInput.value = '';

                document.querySelectorAll('.preset-avatar-option').forEach(function(el) {
                    el.classList.remove('border-cyan-400', 'ring-2', 'ring-cyan-400');
                    el.classList.add('border-white/10');
                    var chk = el.querySelector('.preset-check');
                    if (chk) {
                        chk.style.display = 'none';
                        chk.classList.add('hidden');
                        chk.classList.remove('flex');
                    }
                });
            };
            reader.readAsDataURL(file);
        }
    });
}

function showProfileAlert(message, isSuccess) {
    var box = document.getElementById('profileAlertBox');
    var icon = document.getElementById('profileAlertIcon');
    var msg = document.getElementById('profileAlertMsg');
    if (!box || !msg) return;

    msg.textContent = message;
    if (isSuccess) {
        box.className = 'mb-6 p-4 rounded-2xl flex items-center justify-between gap-3 text-xs font-bold border bg-emerald-500/15 border-emerald-500/40 text-emerald-300';
        if (icon) icon.className = 'fas fa-check-circle text-base text-emerald-400';
    } else {
        box.className = 'mb-6 p-4 rounded-2xl flex items-center justify-between gap-3 text-xs font-bold border bg-red-500/15 border-red-500/40 text-red-300';
        if (icon) icon.className = 'fas fa-exclamation-circle text-base text-red-400';
    }
    box.style.display = 'flex';
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function resetProfileForm() {
    var form = document.getElementById('profileUpdateForm');
    if (form) form.reset();
    window.location.reload();
}

// Handle Form Submission via AJAX
var profileForm = document.getElementById('profileUpdateForm');
if (profileForm) {
    profileForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        var nameInput = document.getElementById('profileNameInput');
        if (!nameInput || !nameInput.value.trim()) {
            showProfileAlert('দয়া করে আপনার নাম প্রদান করুন (Please provide your name).', false);
            return;
        }

        var btn = document.getElementById('btnSaveProfile');
        var originalBtnHtml = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Saving Changes...';
        }

        try {
            var formData = new FormData(profileForm);
            var res = await fetch('/api/profile/update', {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body: formData
            });
            var data = await res.json();

            if (data.success) {
                showProfileAlert(data.message || 'Profile updated successfully!', true);

                if (data.user) {
                    // Update Top Header Banner
                    var headerName = document.getElementById('accountHeaderName');
                    if (headerName && data.user.name) headerName.textContent = data.user.name;

                    var headerPhone = document.getElementById('accountHeaderPhone');
                    var headerPhoneWrap = document.getElementById('accountHeaderPhoneWrapper');
                    if (headerPhone && data.user.phone) {
                        headerPhone.textContent = data.user.phone;
                        if (headerPhoneWrap) headerPhoneWrap.style.display = 'inline-flex';
                    }

                    if (data.user.avatar) {
                        var headerAvatar = document.getElementById('headerProfileAvatarImg');
                        var headerIcon = document.getElementById('headerProfileAvatarIcon');
                        if (headerAvatar) {
                            headerAvatar.src = data.user.avatar;
                            headerAvatar.style.display = 'block';
                            if (headerIcon) headerIcon.style.display = 'none';
                        }
                        var preview = document.getElementById('currentAvatarPreview');
                        if (preview) preview.src = data.user.avatar;

                        // Update navbar avatar images
                        document.querySelectorAll('.user-nav-avatar-img').forEach(function(img) {
                            img.src = data.user.avatar;
                            img.style.display = 'inline-block';
                        });
                    }

                    // Update navbar name texts
                    document.querySelectorAll('.user-display-name-nav').forEach(function(el) {
                        el.textContent = data.user.name;
                    });
                }

                // Smooth reload to apply language and currency across entire store
                setTimeout(function() {
                    window.location.reload();
                }, 600);
            } else {
                showProfileAlert(data.message || 'Failed to update profile.', false);
            }
        } catch(err) {
            showProfileAlert('Network error: ' + err.message, false);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalBtnHtml;
            }
        }
    });
}

function openHwidResetModal(orderId, productName, licenseKey) {
    var modal = document.getElementById('modalHwidReset');
    if (!modal) return;
    document.getElementById('hwidOrderId').value = orderId;
    document.getElementById('hwidProductName').value = productName;
    document.getElementById('hwidLicenseKey').value = licenseKey;
    document.getElementById('hwidDeviceModel').value = '';
    modal.style.display = 'flex';
}

function closeHwidResetModal() {
    var modal = document.getElementById('modalHwidReset');
    if (modal) modal.style.display = 'none';
}

var formHwid = document.getElementById('formHwidResetRequest');
if (formHwid) {
    formHwid.addEventListener('submit', async function(e) {
        e.preventDefault();
        var order_id = document.getElementById('hwidOrderId').value;
        var product_name = document.getElementById('hwidProductName').value;
        var license_key = document.getElementById('hwidLicenseKey').value;
        var reason = document.getElementById('hwidReason').value;
        var device_model = document.getElementById('hwidDeviceModel').value;

        var btn = document.getElementById('btnSubmitHwidReset');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Submitting...';
        }

        try {
            var res = await fetch('/api/hwid/request', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    order_id: order_id,
                    product_name: product_name,
                    license_key: license_key,
                    reason: reason,
                    device_model: device_model
                })
            });
            var data = await res.json();
            if (data.success) {
                alert(data.message || 'HWID reset request submitted successfully!');
                closeHwidResetModal();
                window.location.href = '/account?tab=hwid';
            } else {
                alert(data.message || 'Failed to submit request.');
            }
        } catch(err) {
            alert('Network error submitting request: ' + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane mr-1"></i> Submit Reset Request';
            }
        }
    });
}
</script>

<!-- HWID RESET REQUEST MODAL DIALOG -->
<div id="modalHwidReset" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md" style="display: none;">
    <div class="bg-[#0b1329] border border-amber-500/50 rounded-3xl max-w-lg w-full p-6 text-white shadow-2xl relative animate-fadeIn">
        <button type="button" onclick="closeHwidResetModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-xl font-bold cursor-pointer transition">&times;</button>
        
        <div class="flex items-center gap-3 mb-4 pb-3 border-b border-white/10">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center text-lg">
                <i class="fas fa-microchip"></i>
            </div>
            <div>
                <h3 class="text-sm font-black uppercase font-orbitron text-white m-0 tracking-wide">Request Device / HWID Reset</h3>
                <p class="text-[11px] text-gray-400 m-0">Unlock your license key for phone format or new device.</p>
            </div>
        </div>

        <!-- 1-TIME STRICT LIMIT WARNING -->
        <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-[11px] mb-4 flex items-start gap-2.5">
            <i class="fas fa-exclamation-triangle text-amber-400 text-sm mt-0.5 shrink-0"></i>
            <div class="leading-relaxed">
                <strong class="text-amber-200 uppercase font-mono block mb-0.5">১ বার রিসেট সীমাবদ্ধতা (Strict 1-Time Rule):</strong>
                প্রতিটি লাইসেন্স কীতে গ্রাহক সর্বোচ্চ <b>১ বার</b> HWID রিসেট রিকোয়েস্ট করতে পারবেন। একবার রিসেট হয়ে গেলে এই কী-তে আর ডিভাইস পরিবর্তন করা যাবে না।
            </div>
        </div>

        <form id="formHwidResetRequest">
            <input type="hidden" id="hwidOrderId" value="">
            
            <div class="mb-3">
                <label class="text-[11px] font-bold text-gray-400 uppercase font-mono block mb-1">Product</label>
                <input type="text" id="hwidProductName" readonly class="w-full px-3 py-2 rounded-xl bg-black/60 border border-white/10 text-white font-bold text-xs font-mono outline-none">
            </div>

            <div class="mb-3">
                <label class="text-[11px] font-bold text-gray-400 uppercase font-mono block mb-1">License Key to Unlock</label>
                <input type="text" id="hwidLicenseKey" readonly class="w-full px-3 py-2 rounded-xl bg-black/60 border border-yellow-500/40 text-yellow-300 font-mono font-bold text-xs outline-none select-all">
            </div>

            <div class="mb-3">
                <label class="text-[11px] font-bold text-gray-400 uppercase font-mono block mb-1">Reason for Device Reset *</label>
                <select id="hwidReason" class="w-full px-3 py-2 rounded-xl bg-[#070d1a] border border-cyan-500/40 text-white text-xs outline-none cursor-pointer">
                    <option value="Changed to new phone / device">📱 Changed to new phone / device</option>
                    <option value="Phone formatted / factory reset">🔄 Phone formatted / factory reset</option>
                    <option value="App reinstalled / HWID error in panel">⚠️ App reinstalled / HWID error in panel</option>
                    <option value="Other reason">💬 Other reason</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="text-[11px] font-bold text-gray-400 uppercase font-mono block mb-1">New Device Model / Notes (Optional)</label>
                <input type="text" id="hwidDeviceModel" placeholder="e.g. Redmi Note 12, Samsung S23, Realme..." class="w-full px-3 py-2 rounded-xl bg-[#070d1a] border border-cyan-500/40 text-white text-xs outline-none">
            </div>

            <div class="flex gap-2">
                <button type="submit" id="btnSubmitHwidReset" class="flex-1 py-2.5 px-4 bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-black font-black text-xs uppercase tracking-wider rounded-xl transition shadow cursor-pointer">
                    <i class="fas fa-paper-plane mr-1"></i> Submit Reset Request
                </button>
                <button type="button" onclick="closeHwidResetModal()" class="py-2.5 px-4 bg-white/10 hover:bg-white/15 text-white font-bold text-xs uppercase rounded-xl transition cursor-pointer">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
