                                    </label>

                                    <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition select-none <%= (currentLang === 'en') ? 'border-cyan-400 bg-cyan-950/40 text-cyan-300 shadow-[0_0_10px_rgba(0,240,255,0.25)]' : 'border-white/15 bg-slate-900/60 text-slate-300 hover:border-cyan-500/50' %>">
                                        <input type="radio" name="language" value="en" <%= (currentLang === 'en') ? 'checked' : '' %> class="w-4 h-4 accent-cyan-400">
