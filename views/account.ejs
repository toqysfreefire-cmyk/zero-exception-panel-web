                                    <label class="flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition select-none <%= (currentLang === 'bn') ? 'border-emerald-400 bg-emerald-950/40 text-emerald-300 shadow-[0_0_10px_rgba(16,185,129,0.25)]' : 'border-white/15 bg-slate-900/60 text-slate-300 hover:border-emerald-500/50' %>">
