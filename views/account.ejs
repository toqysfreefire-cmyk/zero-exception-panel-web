                            <!-- Language Preference Card (Bangla / English) -->
                            <div class="p-4 rounded-xl bg-black/60 border border-cyan-500/30">
                                <label style="color: #38bdf8 !important; font-size: 12px; font-weight: 800; font-family: monospace; letter-spacing: 0.5px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fas fa-globe text-cyan-400"></i> WEBSITE LANGUAGE / ওয়েবসাইট ভাষা
                                    </span>
                                    <span class="text-[11px] text-cyan-300 font-bold">বাংলা অথবা English</span>
