<%- include('partials/header') %>

<div class="container mx-auto px-4 py-8 max-w-5xl">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-gray-400 mb-6 font-mono">
        <a href="/" class="hover:text-cyan-400 transition no-underline text-gray-400">Home</a>
        <span>/</span>
        <span class="text-cyan-400 font-bold">My Account &amp; Dashboard</span>
    </div>

    <!-- Main Account Header Banner -->
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#071329] via-[#051a24] to-[#071329] border border-cyan-500/40 shadow-2xl text-white mb-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-4 sm:gap-5">
            <div class="relative group cursor-pointer" onclick="switchAccountTab('tabProfile')" title="Click to Change Photo & Edit Profile">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-tr from-cyan-500/20 to-emerald-500/20 border-2 border-cyan-400/50 text-cyan-300 flex items-center justify-center text-3xl shrink-0 shadow-[0_0_20px_rgba(0,240,255,0.4)] overflow-hidden">
                    <% if (user.avatar) { %>
                        <img src="<%= user.avatar %>" alt="<%= user.name %>" id="headerProfileAvatarImg" class="w-full h-full object-cover transition duration-300 group-hover:scale-110" onerror="this.style.display='none'; document.getElementById('headerProfileAvatarIcon').style.display='flex';" />
                        <div id="headerProfileAvatarIcon" style="display: none;" class="w-full h-full items-center justify-center text-3xl text-cyan-300">
                            <i class="fas fa-user-circle"></i>
                        </div>
                    <% } else { %>
                        <img src="/uploads/avatar/1.jpg" alt="<%= user.name %>" id="headerProfileAvatarImg" style="display: none;" class="w-full h-full object-cover transition duration-300 group-hover:scale-110" />
                        <div id="headerProfileAvatarIcon" class="w-full h-full flex items-center justify-center text-3xl text-cyan-300">
                            <i class="fas fa-user-circle"></i>
                        </div>
                    <% } %>
                </div>
                <!-- Camera / Edit Badge -->
                <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-cyan-400 text-black flex items-center justify-center text-[10px] shadow-lg border-2 border-[#071329] font-bold group-hover:scale-125 transition-transform">
                    <i class="fas fa-camera"></i>
                </div>
            </div>
            <div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    <h1 class="text-xl sm:text-2xl font-black font-orbitron tracking-wide text-white m-0" id="accountHeaderName">
                        <%= user.name || 'Customer' %>
                    </h1>
                    <button type="button" onclick="switchAccountTab('tabProfile')" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-cyan-500/20 hover:bg-cyan-500/40 border border-cyan-400/40 text-cyan-300 transition flex items-center gap-1 cursor-pointer">
                        <i class="fas fa-user-edit text-[9px]"></i> Edit Profile
                    </button>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider <%= (user.role === 'admin') ? 'bg-purple-600 text-white' : ((user.role === 'reseller') ? 'bg-amber-400 text-black shadow' : ((user.role === 'sub_reseller' || user.role === 'sub-reseller') ? 'bg-cyan-400 text-black shadow' : 'bg-emerald-500 text-black')) %>">
                        <i class="fas <%= (user.role === 'reseller') ? 'fa-crown mr-1' : ((user.role === 'sub_reseller' || user.role === 'sub-reseller') ? 'fa-gem mr-1' : ((user.role === 'admin') ? 'fa-shield-alt mr-1' : 'fa-user-check mr-1')) %>"></i>
                        <%= (user.role === 'admin') ? 'ADMINISTRATOR' : ((user.role === 'reseller') ? 'VIP RESELLER' : ((user.role === 'sub_reseller' || user.role === 'sub-reseller') ? 'SUB-RESELLER' : 'CUSTOMER')) %>
                    </span>
                    <% if (typeof userDiscount !== 'undefined' && userDiscount > 0) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500 text-black">
                        <i class="fas fa-tags mr-1"></i> <%= userDiscount %>% VIP Discount
                    </span>
                    <% } %>
                </div>
                <p class="text-xs text-cyan-200/80 font-mono mt-1.5 flex items-center gap-2 flex-wrap">
                    <span class="flex items-center gap-1.5"><i class="fas fa-envelope text-[11px]"></i> <%= user.email %></span>
                    <% if (user.phone) { %>
                    <span>&bull;</span>
                    <span class="flex items-center gap-1.5" id="accountHeaderPhoneWrapper"><i class="fas fa-phone-alt text-[11px]"></i> <span id="accountHeaderPhone"><%= user.phone %></span></span>
                    <% } else { %>
                    <span class="items-center gap-1.5" id="accountHeaderPhoneWrapper" style="display: none;"><span>&bull;</span> <i class="fas fa-phone-alt text-[11px]"></i> <span id="accountHeaderPhone"></span></span>
                    <% } %>
                </p>
            </div>
        </div>

        <!-- Wallet Balance Card & Add Money Button -->
        <div class="p-4 rounded-2xl bg-black/60 border border-emerald-500/40 text-center sm:text-right shrink-0 min-w-[200px] shadow-lg">
            <span class="text-[10px] uppercase font-bold text-gray-400 block tracking-wider">Store Wallet Balance:</span>
            <div class="flex items-baseline justify-center sm:justify-end gap-1.5 mt-0.5">
                <span class="text-3xl font-black font-orbitron text-emerald-400"><%= (user.wallet_balance || 0) %></span>
                <span class="text-sm font-bold text-white">৳ BDT</span>
            </div>
            <a href="/add-funds" class="mt-2.5 inline-flex items-center justify-center gap-1.5 w-full px-3.5 py-1.5 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-black text-xs font-black uppercase tracking-wider rounded-xl transition shadow no-underline cursor-pointer">
                <i class="fas fa-plus-circle"></i> Add Funds / টাকা লোড
            </a>
            <button type="button" onclick="openGiftCardModal('buy')" class="mt-2 inline-flex items-center justify-center gap-1.5 w-full px-3.5 py-1.5 bg-gradient-to-r from-purple-600 via-pink-600 to-rose-500 hover:from-purple-500 hover:to-rose-400 text-white text-xs font-black uppercase tracking-wider rounded-xl transition shadow cursor-pointer">
                <i class="fas fa-gift"></i> Buy Gift Card / গিফট দিন
            </button>
        </div>
    </div>

    <!-- Daily Spin & Win Banner -->
    <div class="mb-6 p-4 rounded-3xl bg-gradient-to-r from-amber-500/15 via-purple-500/15 to-pink-500/15 border border-amber-400/40 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl relative overflow-hidden">
        <div class="flex items-center gap-3.5 text-center sm:text-left">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-amber-300 text-2xl shrink-0 shadow-[0_0_15px_rgba(245,158,11,0.3)]">
                <i class="fas fa-dharmachakra"></i>
            </div>
            <div>
                <h3 class="text-sm font-black font-orbitron uppercase text-white m-0 tracking-wide flex items-center justify-center sm:justify-start gap-2">
                    Lucky Spin &amp; Win
                    <span class="text-[9px] px-2 py-0.5 rounded-full bg-amber-400 text-black font-black">Spins: <%= (typeof user !== 'undefined' && user.spin_credits) ? user.spin_credits : 0 %></span>
                </h3>
                <p class="text-xs m-0 mt-0.5" style="color: #fef08a !important; font-weight: 600;">প্রতি ৫০০৳ ডিপোজিট বা ৫০০৳ অর্ডারে পাবেন ১টি লাকি স্পিন! সর্বোচ্চ ১০৳ ব্যালেন্স ও ৫% ভিআইপি কুপন জেতার সুযোগ।</p>
            </div>
        </div>
        <button type="button" onclick="openLuckySpinModal()" class="shrink-0 px-5 py-2.5 rounded-2xl bg-gradient-to-r from-amber-500 to-pink-600 hover:from-amber-400 hover:to-pink-500 text-white font-black font-orbitron text-xs uppercase tracking-wider shadow-[0_4px_20px_rgba(245,158,11,0.4)] transition transform hover:scale-105 cursor-pointer">
            <i class="fas fa-play me-1.5"></i> Spin Now (স্পিন করুন)
        </button>
    </div>

    <!-- Discord Refer & Earn Banner (10 Refers -> 10৳ Wallet Reward) -->
    <div class="mb-6 p-4 sm:p-5 rounded-3xl bg-gradient-to-r from-[#5865F2]/25 via-[#3b82f6]/15 to-[#06b6d4]/20 border border-[#5865F2]/50 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-[0_4px_25px_rgba(88,101,242,0.25)] relative overflow-hidden">
        <div class="flex items-center gap-3.5 text-center sm:text-left">
            <div class="w-12 h-12 rounded-2xl bg-[#5865F2]/30 border border-[#5865F2]/60 flex items-center justify-center text-[#5865F2] text-2xl shrink-0 shadow-[0_0_15px_rgba(88,101,242,0.5)]">
                <i class="fab fa-discord text-white"></i>
            </div>
            <div>
                <h3 class="text-sm font-black font-orbitron uppercase text-white m-0 tracking-wide flex items-center justify-center sm:justify-start gap-2">
                    Discord Refer &amp; Earn (১০ রেফারে ১০৳)
                    <span class="text-[9px] px-2.5 py-0.5 rounded-full bg-[#5865F2] text-white font-black font-mono">Progress: <%= (typeof user !== 'undefined' && user.referral_current) ? user.referral_current : 0 %>/10</span>
                </h3>
                <p class="text-xs text-cyan-200 m-0 mt-0.5">প্রতি ১০ জন বন্ধুকে রেফার করলেই ১০৳ ওয়ালেটে পাবেন। ১০ জন পূর্ণ হলে প্রগ্রেস আবার ০/১০ হয়ে যাবে!</p>
            </div>
        </div>
        <button type="button" onclick="switchAccountTab('tabReferrals')" style="background: linear-gradient(135deg, #5865F2, #0284c7) !important;" class="shrink-0 px-5 py-2.5 rounded-2xl text-white font-black font-orbitron text-xs uppercase tracking-wider shadow-[0_4px_20px_rgba(88,101,242,0.4)] transition transform hover:scale-105 cursor-pointer flex items-center gap-2">
            <i class="fas fa-link"></i>
            <span>My Invite Link (রেফারেল লিংক)</span>
        </button>
    </div>

    <!-- Interactive Navigation Tabs -->
    <div class="flex items-center gap-2 sm:gap-3 overflow-x-auto pb-2 mb-6 border-b border-cyan-500/20" id="accountTabsNav">
        <button type="button" class="acc-tab-btn <%= (activeTab === 'orders' || !activeTab) ? 'active' : '' %>" data-target="tabOrders">
            <i class="fas fa-shopping-bag"></i>
            <span>Order History (<%= orders ? orders.length : 0 %>)</span>
        </button>

        <button type="button" class="acc-tab-btn <%= (activeTab === 'keys') ? 'active' : '' %>" data-target="tabKeys">
            <i class="fas fa-key"></i>
            <span>Key History (<%= keys ? keys.length : 0 %>)</span>
        </button>

        <button type="button" class="acc-tab-btn <%= (activeTab === 'deposits') ? 'active' : '' %>" data-target="tabDeposits">
            <i class="fas fa-money-check-alt"></i>
            <span>Deposit History (<%= deposits ? deposits.length : 0 %>)</span>
        </button>

        <button type="button" class="acc-tab-btn <%= (activeTab === 'hwid') ? 'active' : '' %>" data-target="tabHwid">
            <i class="fas fa-microchip"></i>
            <span>HWID Resets (<%= (typeof hwidRequests !== 'undefined' && hwidRequests) ? hwidRequests.length : 0 %>)</span>
        </button>

        <button type="button" class="acc-tab-btn <%= (activeTab === 'referrals' || activeTab === 'referral') ? 'active' : '' %>" data-target="tabReferrals">
            <i class="fab fa-discord text-indigo-400"></i>
            <span>Refer &amp; Earn (<%= (typeof user !== 'undefined' && user.referral_current) ? user.referral_current : 0 %>/10)</span>
        </button>

        <button type="button" class="acc-tab-btn <%= (activeTab === 'profile') ? 'active' : '' %>" data-target="tabProfile">
            <i class="fas fa-user-shield"></i>
            <span>My Profile</span>
        </button>
    </div>

    <!-- ============================================================
         TAB 1: ORDER HISTORY
         ============================================================ -->
    <div class="acc-tab-content <%= (activeTab === 'orders' || !activeTab) ? 'active' : '' %>" id="tabOrders">
        <div class="bg-gradient-to-b from-[#091224] to-[#050b17] border border-cyan-500/30 rounded-3xl p-6 shadow-2xl text-white">
            <div class="flex items-center justify-between gap-3 mb-5">
                <h2 class="text-base font-black uppercase font-orbitron text-white tracking-wider m-0 flex items-center gap-2">
                    <i class="fas fa-shopping-bag text-cyan-400"></i> My Purchased Orders
                </h2>
                <a href="/" class="text-xs text-cyan-400 hover:text-cyan-300 font-bold no-underline flex items-center gap-1">
                    <i class="fas fa-cart-plus"></i> Buy More Panels
                </a>
            </div>

            <% if (orders && orders.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-gray-300">
                    <thead class="text-[11px] uppercase bg-black/40 text-gray-400 border-b border-cyan-500/20">
                        <tr>
                            <th class="py-3 px-3">Order ID</th>
                            <th class="py-3 px-3">Product &amp; Variant</th>
                            <th class="py-3 px-3">Amount</th>
                            <th class="py-3 px-3">Gateway</th>
                            <th class="py-3 px-3">Status</th>
                            <th class="py-3 px-3">License Key</th>
                            <th class="py-3 px-3 text-right">Receipt</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <% orders.forEach(function(o) { %>
                        <tr class="hover:bg-white/5 transition">
                            <td class="py-3 px-3 font-mono font-bold text-cyan-400 whitespace-nowrap">
                                <a href="/order-success/<%= o.id %>" class="hover:underline text-cyan-400 flex items-center gap-1" title="View order receipt">
                                    <%= o.id %> <i class="fas fa-external-link-alt text-[9px] text-gray-500"></i>
                                </a>
                            </td>
                            <td class="py-3 px-3">
                                <div class="font-bold text-white"><%= o.product_name %></div>
                                <div class="text-[11px] text-cyan-300 font-mono">📦 <%= o.variant %></div>
                            </td>
                            <td class="py-3 px-3 font-bold text-emerald-400 font-orbitron whitespace-nowrap">
                                <%= o.price %>৳
                            </td>
                            <td class="py-3 px-3 text-gray-300 whitespace-nowrap font-sans font-semibold">
                                <%= o.payment_method || 'bKash' %>
                            </td>
                            <td class="py-3 px-3 whitespace-nowrap">
                                <% if (o.status === 'completed') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
                                    <i class="fas fa-check-circle mr-1"></i> Completed
                                </span>
                                <% } else if (o.status === 'processing') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-blue-500/20 text-blue-400 border border-blue-500/40">
                                    <i class="fas fa-spinner fa-spin mr-1"></i> Processing
                                </span>
                                <% } else if (o.status === 'cancelled') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-red-500/20 text-red-400 border border-red-500/40">
                                    <i class="fas fa-times-circle mr-1"></i> Cancelled
                                </span>
                                <% } else { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-amber-500/20 text-amber-400 border border-amber-500/40 animate-pulse">
                                    <i class="fas fa-clock mr-1"></i> Pending Verification
                                </span>
                                <% } %>
                            </td>
                            <td class="py-3 px-3">
                                <% if (o.license_key) { %>
                                <div class="flex items-center gap-1.5 bg-black/60 text-yellow-300 px-2.5 py-1 rounded-lg border border-yellow-500/30 font-mono text-[11px] max-w-xs">
                                    <span class="truncate select-all font-bold" title="<%= o.license_key %>"><%= o.license_key %></span>
                                    <button type="button" onclick="navigator.clipboard.writeText('<%= o.license_key %>'); this.innerText='COPIED!'; setTimeout(() => this.innerHTML='<i class=\'fas fa-copy\'></i>', 2000)" class="px-1.5 py-0.5 bg-emerald-500/30 hover:bg-emerald-500/50 text-emerald-300 rounded text-[10px] font-bold shrink-0 transition" title="Copy Key">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                                <% } else { %>
                                <span class="text-[11px] text-gray-500 italic">Key will appear once verified</span>
                                <% } %>
                            </td>
                            <td class="py-3 px-3 text-right whitespace-nowrap">
                                <a href="/order-success/<%= o.id %>" class="inline-flex items-center gap-1 px-2.5 py-1 bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 border border-cyan-500/40 rounded-lg text-[11px] font-bold transition no-underline">
                                    <i class="fas fa-file-invoice"></i> Receipt
                                </a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="text-center py-12 text-gray-400 bg-black/30 rounded-2xl border border-white/5">
                <i class="fas fa-shopping-bag text-4xl mb-3 text-gray-600 block"></i>
                <h4 class="text-sm font-bold text-white mb-1">No orders placed yet</h4>
                <p class="text-xs text-gray-400 mb-4">Browse our premium gaming panels, hacks, and mods to place your first order!</p>
                <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-black font-black text-xs uppercase tracking-wider rounded-xl transition shadow no-underline">
                    <i class="fas fa-gamepad"></i> Explore Panels Store
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <!-- ============================================================
         TAB 2: KEY HISTORY
         ============================================================ -->
    <div class="acc-tab-content <%= (activeTab === 'keys') ? 'active' : '' %>" id="tabKeys">
        <div class="bg-gradient-to-b from-[#091224] to-[#050b17] border border-cyan-500/30 rounded-3xl p-6 shadow-2xl text-white">
            <div class="flex items-center justify-between gap-3 mb-5">
                <h2 class="text-base font-black uppercase font-orbitron text-white tracking-wider m-0 flex items-center gap-2">
                    <i class="fas fa-key text-yellow-400"></i> My Delivered License Keys
                </h2>
                <span class="text-xs text-gray-400 font-mono">Instant Copy &amp; Verification</span>
            </div>

            <% if (keys && keys.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% keys.forEach(function(k) { %>
                <div class="p-4 rounded-2xl bg-black/60 border border-yellow-500/30 hover:border-yellow-400/60 transition shadow-lg relative group">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-xs font-black text-white font-orbitron"><%= k.product_name %></span>
                        <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
                            <%= k.variant %>
                        </span>
                    </div>

                    <!-- Key Box -->
                    <div class="p-3 rounded-xl bg-[#070d1a] border border-cyan-500/40 my-2 flex items-center justify-between gap-2">
                        <span class="font-mono text-xs font-bold text-yellow-300 select-all truncate tracking-wider" id="keyText_<%= k.id %>">
                            <%= k.license_key %>
                        </span>
                        <button type="button" onclick="navigator.clipboard.writeText('<%= k.license_key %>'); this.innerText='COPIED!'; setTimeout(() => this.innerHTML='<i class=\'fas fa-copy\'></i> Copy', 2000)" class="px-3 py-1 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-black text-xs font-black uppercase tracking-wider rounded-lg transition shrink-0 cursor-pointer shadow">
                            <i class="fas fa-copy"></i> Copy
                        </button>
                    </div>

                    <%
                        const isHwidResetUsed = (typeof hwidRequests !== 'undefined' && hwidRequests)
                            ? hwidRequests.some(h => h.license_key === k.license_key && h.status === 'approved') || (k.hwid_reset_count && k.hwid_reset_count >= 1)
                            : false;
                        const isHwidPending = (typeof hwidRequests !== 'undefined' && hwidRequests)
                            ? hwidRequests.some(h => h.license_key === k.license_key && h.status === 'pending')
                            : false;
                    %>
                    <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-gray-400 font-mono mt-3 pt-2 border-t border-white/5">
                        <div class="flex items-center gap-3">
                            <span>Order: <strong class="text-cyan-400"><%= k.id %></strong></span>
                            <span><%= k.created_at ? new Date(k.created_at).toLocaleDateString() : 'Active' %></span>
                        </div>
                        <% if (isHwidResetUsed) { %>
                        <span class="px-2.5 py-1 bg-gray-500/20 text-gray-400 border border-gray-500/40 rounded-lg text-[10px] font-bold flex items-center gap-1 select-none" title="This key has already been reset once. Limit reached.">
                            <i class="fas fa-lock"></i> Reset Used (1/1)
                        </span>
                        <% } else if (isHwidPending) { %>
                        <span class="px-2.5 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/40 rounded-lg text-[10px] font-bold flex items-center gap-1 animate-pulse select-none">
                            <i class="fas fa-hourglass-half"></i> Reset Pending (1/1)
                        </span>
                        <% } else { %>
                        <button type="button" onclick="openHwidResetModal('<%= k.id %>', '<%= (k.product_name || '').replace(/'/g, '') %>', '<%= (k.license_key || '').replace(/'/g, '') %>')" class="px-2.5 py-1 bg-amber-500/15 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 rounded-lg text-[10px] font-black uppercase tracking-wider transition flex items-center gap-1 cursor-pointer">
                            <i class="fas fa-microchip"></i> Reset Device / HWID (1 Time)
                        </button>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div class="text-center py-12 text-gray-400 bg-black/30 rounded-2xl border border-white/5">
                <i class="fas fa-key text-4xl mb-3 text-gray-600 block"></i>
                <h4 class="text-sm font-bold text-white mb-1">No license keys assigned yet</h4>
                <p class="text-xs text-gray-400 max-w-md mx-auto">
                    When you order a game panel or mod, our system or admin assigns your unique license key. Once assigned, all your license keys will permanently stay organized right here!
                </p>
                <a href="/" class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-emerald-500 hover:from-cyan-400 hover:to-emerald-400 text-black font-black text-xs uppercase tracking-wider rounded-xl transition shadow no-underline">
                    <i class="fas fa-shopping-cart"></i> Order a Key Now
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <!-- ============================================================
         TAB 3: DEPOSIT / PAYMENT HISTORY
         ============================================================ -->
    <div class="acc-tab-content <%= (activeTab === 'deposits') ? 'active' : '' %>" id="tabDeposits">
        <div class="bg-gradient-to-b from-[#091224] to-[#050b17] border border-cyan-500/30 rounded-3xl p-6 shadow-2xl text-white">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-5">
                <div>
                    <h2 class="text-base font-black uppercase font-orbitron text-white tracking-wider m-0 flex items-center gap-2">
                        <i class="fas fa-money-check-alt text-emerald-400"></i> My Deposit &amp; Wallet Recharge History
                    </h2>
                    <p class="text-xs text-gray-400 mt-1 m-0">Track all your money loading requests, TrxIDs, and approval status.</p>
                </div>
                <a href="/add-funds" class="px-4 py-2 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-black font-black text-xs uppercase tracking-wider rounded-xl transition shadow flex items-center gap-1.5 no-underline shrink-0">
                    <i class="fas fa-plus-circle"></i> Add Funds Now
                </a>
            </div>

            <% if (deposits && deposits.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-gray-300">
                    <thead class="text-[11px] uppercase bg-black/40 text-gray-400 border-b border-cyan-500/20">
                        <tr>
                            <th class="py-3 px-3">Deposit ID</th>
                            <th class="py-3 px-3">Payment Method</th>
                            <th class="py-3 px-3">Amount</th>
                            <th class="py-3 px-3">Sender Phone</th>
                            <th class="py-3 px-3">TrxID</th>
                            <th class="py-3 px-3">Status</th>
                            <th class="py-3 px-3 text-right">Date &amp; Time</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 font-mono">
                        <% deposits.forEach(function(d) { %>
                        <tr class="hover:bg-white/5 transition">
                            <td class="py-3 px-3 font-bold text-cyan-400"><%= d.id %></td>
                            <td class="py-3 px-3 font-sans font-bold text-white"><%= d.payment_method %></td>
                            <td class="py-3 px-3 font-bold font-orbitron <%= (d.status === 'reverted' || d.amount < 0 || d.is_deduction) ? 'text-red-400' : 'text-emerald-400' %>">
                                <%= (d.status === 'reverted' || d.amount < 0 || d.is_deduction) ? '-' : '+' %><%= Math.abs(d.amount) %>৳
                            </td>
                            <td class="py-3 px-3 text-gray-300"><%= d.sender_phone || 'N/A' %></td>
                            <td class="py-3 px-3 select-all truncate max-w-xs text-yellow-300 font-bold"><%= d.transaction_id %></td>
                            <td class="py-3 px-3">
                                <% if (d.status === 'approved') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
                                    <i class="fas fa-check-circle mr-1"></i> Approved (+Added)
                                </span>
                                <% } else if (d.status === 'reverted') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-red-500/20 text-red-400 border border-red-500/40">
                                    <i class="fas fa-undo mr-1"></i> Reverted / Deducted
                                </span>
                                <% } else if (d.status === 'rejected') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-red-500/20 text-red-400 border border-red-500/40">
                                    <i class="fas fa-times-circle mr-1"></i> Rejected
                                </span>
                                <% } else { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-amber-500/20 text-amber-400 border border-amber-500/40 animate-pulse">
                                    <i class="fas fa-hourglass-half mr-1"></i> Under Review
                                </span>
                                <% } %>
                            </td>
                            <td class="py-3 px-3 text-right text-gray-400">
                                <%= d.created_at ? new Date(d.created_at).toLocaleString('en-US', { dateStyle: 'short', timeStyle: 'short' }) : 'Recently' %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="text-center py-12 text-gray-400 bg-black/30 rounded-2xl border border-white/5">
                <i class="fas fa-wallet text-4xl mb-3 text-gray-600 block"></i>
                <h4 class="text-sm font-bold text-white mb-1">No deposit history yet</h4>
                <p class="text-xs text-gray-400 max-w-md mx-auto mb-4">
                    Top up your account balance via bKash, Nagad, Rocket or Binance to enjoy 1-click instant checkouts without needing to type TrxID during purchase!
                </p>
                <a href="/add-funds" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-black font-black text-xs uppercase tracking-wider rounded-xl transition shadow no-underline">
                    <i class="fas fa-plus-circle"></i> Add Funds to Wallet
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <!-- ============================================================
         TAB: HWID & DEVICE RESETS
         ============================================================ -->
    <div class="acc-tab-content <%= (activeTab === 'hwid') ? 'active' : '' %>" id="tabHwid">
        <div class="bg-gradient-to-b from-[#091224] to-[#050b17] border border-cyan-500/30 rounded-3xl p-6 shadow-2xl text-white">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-5">
                <div>
                    <h2 class="text-base font-black uppercase font-orbitron text-white tracking-wider m-0 flex items-center gap-2">
                        <i class="fas fa-microchip text-amber-400"></i> HWID &amp; Device Lock Reset Requests
                    </h2>
                    <p class="text-xs text-gray-400 mt-1 m-0">Changed phone or formatted device? Request a device lock reset for your panel license key.</p>
                </div>
            </div>

            <% if (typeof hwidRequests !== 'undefined' && hwidRequests && hwidRequests.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-gray-300">
                    <thead class="text-[11px] uppercase bg-black/40 text-gray-400 border-b border-cyan-500/20">
                        <tr>
                            <th class="py-3 px-3">Request ID</th>
                            <th class="py-3 px-3">Product Name</th>
                            <th class="py-3 px-3">License Key</th>
                            <th class="py-3 px-3">Reason / Device</th>
                            <th class="py-3 px-3">Status</th>
                            <th class="py-3 px-3 text-right">Requested At</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 font-mono">
                        <% hwidRequests.forEach(function(h) { %>
                        <tr class="hover:bg-white/5 transition">
                            <td class="py-3 px-3 font-bold text-amber-400"><%= h.id %></td>
                            <td class="py-3 px-3 font-sans font-bold text-white"><%= h.product_name %></td>
                            <td class="py-3 px-3 select-all truncate max-w-xs text-yellow-300 font-bold"><%= h.license_key %></td>
                            <td class="py-3 px-3 font-sans text-gray-300">
                                <div><b><%= h.reason %></b></div>
                                <small class="text-gray-400 font-mono"><%= h.device_model || 'Device' %></small>
                            </td>
                            <td class="py-3 px-3">
                                <% if (h.status === 'approved') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
                                    <i class="fas fa-check-circle mr-1"></i> Reset Done / Unlocked
                                </span>
                                <% } else if (h.status === 'rejected') { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-red-500/20 text-red-400 border border-red-500/40">
                                    <i class="fas fa-times-circle mr-1"></i> Rejected
                                </span>
                                <% } else { %>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-amber-500/20 text-amber-400 border border-amber-500/40 animate-pulse">
                                    <i class="fas fa-clock mr-1"></i> Pending Verification
                                </span>
                                <% } %>
                            </td>
                            <td class="py-3 px-3 text-right text-gray-400">
                                <%= h.created_at ? new Date(h.created_at).toLocaleString('en-US', { dateStyle: 'short', timeStyle: 'short' }) : 'Recently' %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="text-center py-12 text-gray-400 bg-black/30 rounded-2xl border border-white/5">
                <i class="fas fa-microchip text-4xl mb-3 text-gray-600 block"></i>
                <h4 class="text-sm font-bold text-white mb-1">No HWID reset requests submitted yet</h4>
                <p class="text-xs text-gray-400 max-w-md mx-auto mb-4">
                    If your panel key gives a device lock or HWID error on your new phone, go to the <b>Key History</b> tab and click <b>Reset Device / HWID</b> to submit an unlock request!
                </p>
            </div>
            <% } %>
        </div>
    </div>

    <!-- ============================================================
         TAB 4: MY PROFILE & IDENTITY SETTINGS
         ============================================================ -->
    <div class="acc-tab-content <%= (activeTab === 'profile') ? 'active' : '' %>" id="tabProfile">
        <div class="bg-gradient-to-b from-[#091224] to-[#050b17] border border-cyan-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl text-white">
            
            <!-- Tab Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-white/10">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase font-mono tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">
                            IDENTITY &amp; PREFERENCES
                        </span>
                        <span class="text-xs text-gray-400 font-mono">User ID: #<%= user.id || 'MEM' %></span>
                    </div>
                    <h2 class="text-lg sm:text-xl font-black uppercase font-orbitron text-white tracking-wider m-0 mt-1.5 flex items-center gap-2.5">
                        <i class="fas fa-user-astronaut text-cyan-400"></i> My Profile &amp; Settings
                    </h2>
                    <p class="text-xs m-0 mt-1" style="color: #e2e8f0 !important; font-weight: 500;">আপনার নাম, প্রোফাইল পিকচার এবং যোগাযোগের তথ্য পরিবর্তন করুন।</p>
                </div>

                <div class="flex items-center gap-2">
                    <span class="px-3 py-1.5 rounded-xl bg-black/60 border border-emerald-500/40 text-emerald-400 text-xs font-mono font-bold flex items-center gap-1.5">
                        <i class="fas fa-wallet"></i> <%= (user.wallet_balance || 0) %>৳ BDT
                    </span>
                    <button type="button" onclick="openLuckySpinModal()" class="px-3 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-amber-300 text-xs font-mono font-bold flex items-center gap-1.5 cursor-pointer transition">
                        <i class="fas fa-dharmachakra"></i> <%= (user.spin_credits || 0) %> Spins
                    </button>
                </div>
            </div>

            <!-- Dynamic Notification Alert Box -->
            <div id="profileAlertBox" style="display: none;" class="mb-6 p-4 rounded-2xl flex items-center justify-between gap-3 text-xs font-bold border transition-all duration-300">
                <div class="flex items-center gap-2.5">
                    <i id="profileAlertIcon" class="fas fa-check-circle text-base"></i>
                    <span id="profileAlertMsg">Profile updated successfully!</span>
                </div>
                <button type="button" onclick="document.getElementById('profileAlertBox').style.display='none'" class="text-gray-400 hover:text-white text-base leading-none">&times;</button>
            </div>

            <!-- Form starts -->
            <form id="profileUpdateForm" action="/api/profile/update" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="is_ajax" value="1">
                <input type="hidden" name="avatarPreset" id="profileAvatarPresetInput" value="">
                <input type="file" name="avatarFile" id="profileAvatarFileInput" accept="image/png, image/jpeg, image/webp, image/gif" style="display: none;">

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    
                    <!-- LEFT COLUMN: AVATAR CUSTOMIZER (5 Cols) -->
                    <div class="lg:col-span-5 flex flex-col items-center p-6 rounded-2xl bg-black/40 border border-cyan-500/20 text-center relative overflow-hidden">
                        <div class="absolute -top-12 -left-12 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>
                        <div class="absolute -bottom-12 -right-12 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

                        <span class="text-[11px] font-bold uppercase tracking-wider font-mono mb-4 block" style="color: #38bdf8 !important;">
                            Profile Avatar / ছবি
                        </span>

                        <!-- Main Interactive Avatar Preview -->
                        <div class="relative group cursor-pointer mb-4" onclick="document.getElementById('profileAvatarFileInput').click()" title="Click to upload custom picture">
                            <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl p-1 bg-gradient-to-tr from-cyan-400 via-emerald-400 to-purple-500 shadow-[0_0_25px_rgba(0,240,255,0.35)]">
                                <div class="w-full h-full rounded-[22px] overflow-hidden bg-[#070e1c] flex items-center justify-center relative">
                                    <% if (user.avatar) { %>
                                        <img src="<%= user.avatar %>" alt="<%= user.name %>" id="currentAvatarPreview" class="w-full h-full object-cover transition duration-300 group-hover:scale-110" onerror="this.src='/uploads/avatar/1.jpg';" />
                                    <% } else { %>
                                        <img src="/uploads/avatar/1.jpg" alt="<%= user.name %>" id="currentAvatarPreview" class="w-full h-full object-cover transition duration-300 group-hover:scale-110" />
                                    <% } %>
                                    
                                    <!-- Hover Overlay -->
                                    <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center text-cyan-300 gap-1">
                                        <i class="fas fa-camera text-xl"></i>
                                        <span class="text-[10px] font-bold uppercase tracking-wider font-orbitron">Change Photo</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Camera floating badge -->
                            <div class="absolute -bottom-2 -right-2 w-9 h-9 rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-400 text-black flex items-center justify-center shadow-lg border-2 border-[#091224] text-xs font-bold group-hover:scale-110 transition-transform">
                                <i class="fas fa-camera"></i>
                            </div>
                        </div>

                        <!-- Upload & Preset Buttons -->
                        <div class="w-full flex flex-col gap-2 mb-4">
                            <button type="button" onclick="document.getElementById('profileAvatarFileInput').click()" style="background: linear-gradient(135deg, rgba(6,182,212,0.25), rgba(59,130,246,0.25)) !important; border: 1.5px solid #00f0ff !important; color: #00f0ff !important; font-weight: 800; font-size: 12px; border-radius: 12px; padding: 10px 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 15px rgba(0,240,255,0.2);">
                                <i class="fas fa-cloud-upload-alt text-base"></i>
                                <span>Upload Custom Image (ছবি আপলোড)</span>
                            </button>
                            <button type="button" onclick="togglePresetGallery()" style="background: rgba(245, 158, 11, 0.15) !important; border: 1.5px solid #f59e0b !important; color: #fbbf24 !important; font-weight: 800; font-size: 12px; border-radius: 12px; padding: 10px 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <i class="fas fa-th text-xs"></i>
                                <span id="togglePresetText">Choose Gaming Preset Avatars (৭টি অ্যাভাটার)</span>
                            </button>
                        </div>

                        <!-- Gaming Preset Avatar Selector (Hidden by default, toggles open) -->
                        <div id="presetAvatarGallery" class="w-full pt-3 border-t border-white/10" style="display: none;">
                            <span class="text-[10px] text-gray-300 uppercase font-mono block mb-2 text-left flex items-center justify-between">
                                <span>Select Ready-made Avatar:</span>
                                <span class="text-cyan-300 text-[10px] font-bold">Click to Apply</span>
                            </span>
                            <div class="grid grid-cols-4 sm:grid-cols-7 lg:grid-cols-4 gap-2.5">
                                <% 
                                const readyAvatars = [
                                    { file: '/uploads/avatar/1.jpg', name: 'Cyber Ninja' },
                                    { file: '/uploads/avatar/12388.jpg', name: 'Ghost Rider' },
                                    { file: '/uploads/avatar/4377.jpg', name: 'Neon Glitch' },
                                    { file: '/uploads/avatar/4500.jpg', name: 'Viper Assassin' },
                                    { file: '/uploads/avatar/5005.jpg', name: 'Gold King' },
                                    { file: '/uploads/avatar/5341.jpg', name: 'Shadow Ghost' },
                                    { file: '/uploads/avatar/6482.jpg', name: 'Cyberpunk' }
                                ];
                                readyAvatars.forEach(function(av, i) { 
                                %>
                                <div class="preset-avatar-option relative rounded-xl overflow-hidden border-2 border-white/20 hover:border-cyan-400 transition cursor-pointer group" onclick="selectPresetAvatar('<%= av.file %>', this)" title="<%= av.name %>">
                                    <img src="<%= av.file %>" alt="<%= av.name %>" class="w-12 h-12 object-cover transition group-hover:scale-110" />
                                    <div class="preset-check absolute inset-0 bg-cyan-500/70 hidden items-center justify-center text-black text-xs font-bold">
                                        <i class="fas fa-check"></i>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                        </div>

                        <div class="text-[11px] font-mono mt-3" style="color: #cbd5e1 !important; font-weight: 600;">
                            JPG, PNG, WEBP, GIF (Max 5MB)
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: PROFILE DETAILS FORM (7 Cols) -->
                    <div class="lg:col-span-7 flex flex-col justify-between">
                        <div class="space-y-4">
                            
                            <!-- Display Name Field -->
                            <div>
                                <label for="profileNameInput" style="color: #38bdf8 !important; font-size: 12px; font-weight: 800; font-family: monospace; letter-spacing: 0.5px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fas fa-user-edit text-cyan-400"></i> FULL NAME / DISPLAY NAME *
                                    </span>
                                    <span style="color: #7dd3fc !important; font-size: 11px; font-weight: bold;">২-৬০ অক্ষর</span>
                                </label>
                                <div class="relative">
                                    <input type="text" id="profileNameInput" name="name" value="<%= user.name || '' %>" required minlength="2" maxlength="60" placeholder="Enter your name" style="background: #060e1f !important; border: 1.5px solid #00f0ff !important; color: #ffffff !important; font-size: 14px; font-weight: bold; border-radius: 12px; padding: 12px 40px 12px 16px; width: 100%; outline: none;" class="font-sans focus:ring-2 focus:ring-cyan-400/30">
                                    <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-cyan-400 text-sm">
                                        <i class="fas fa-pen"></i>
                                    </span>
                                </div>
                                <p style="color: #e2e8f0 !important; font-size: 12px; font-weight: 500; margin-top: 5px; line-height: 1.4;">আপনার অ্যাকাউন্টের সকল অর্ডার ও ইনভয়েসে এই নাম প্রদর্শিত হবে।</p>
                            </div>

                            <!-- Phone / WhatsApp Field -->
                            <div>
                                <label for="profilePhoneInput" style="color: #34d399 !important; font-size: 12px; font-weight: 800; font-family: monospace; letter-spacing: 0.5px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fab fa-whatsapp text-emerald-400 text-base"></i> WHATSAPP / MOBILE NUMBER
                                    </span>
                                    <span style="color: #6ee7b7 !important; font-size: 11px; font-weight: bold;">ঐচ্ছিক</span>
                                </label>
                                <div class="relative">
                                    <input type="text" id="profilePhoneInput" name="phone" value="<%= user.phone || '' %>" placeholder="e.g. 017xxxxxxxx or +88017xxxxxxxx" style="background: #060e1f !important; border: 1.5px solid #10b981 !important; color: #ffffff !important; font-size: 14px; font-weight: bold; border-radius: 12px; padding: 12px 40px 12px 16px; width: 100%; outline: none;" class="font-mono focus:ring-2 focus:ring-emerald-400/30">
                                    <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-emerald-400 text-base">
                                        <i class="fab fa-whatsapp"></i>
                                    </span>
                                </div>
                                <p style="color: #e2e8f0 !important; font-size: 12px; font-weight: 500; margin-top: 5px; line-height: 1.4;">অর্ডার ডেলিভারি নিশ্চিত করতে ও হোয়াটসঅ্যাপ সাপোর্ট মেসেজ পেতে ব্যবহৃত হবে।</p>
                            </div>

                            <!-- Registered Email (Read Only) -->
                            <div>
                                <label style="color: #c084fc !important; font-size: 12px; font-weight: 800; font-family: monospace; letter-spacing: 0.5px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fas fa-envelope-open-text text-purple-400"></i> REGISTERED ACCOUNT EMAIL
                                    </span>
                                    <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-emerald-500/25 text-emerald-300 border border-emerald-500/50">
                                        <i class="fas fa-shield-alt mr-1"></i> VERIFIED
                                    </span>
                                </label>
                                <div class="relative">
                                    <input type="email" value="<%= user.email %>" readonly disabled style="background: #050b17 !important; border: 1.5px solid rgba(255,255,255,0.2) !important; color: #e2e8f0 !important; font-size: 14px; font-weight: bold; border-radius: 12px; padding: 12px 40px 12px 16px; width: 100%; cursor: not-allowed;" class="font-mono">
                                    <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm">
                                        <i class="fas fa-lock"></i>
                                    </span>
