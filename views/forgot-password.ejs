<%- include('partials/header') %>

<div class="container mx-auto px-4 py-12 max-w-lg">
    <div class="mx-auto bg-[#0f172a] border border-[#1e293b] rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden" style="box-shadow: 0 10px 35px rgba(0, 240, 255, 0.08);">
        <!-- Top Glow Accent -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-400 via-pink-500 to-emerald-400"></div>

        <!-- Header -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-2xl mb-3 shadow-[0_0_15px_rgba(6,182,212,0.25)]">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1 class="text-2xl font-black text-white tracking-wide uppercase font-primary">Forgot Password</h1>
            <p class="text-xs text-slate-400 mt-1">
                আপনার পাসওয়ার্ড রিসেট করতে রেজিস্টার্ড Gmail প্রদান করুন
            </p>
        </div>

        <!-- Status / Alert Box -->
        <div id="alertBox" class="hidden mb-5 p-3.5 rounded-xl text-xs font-semibold flex items-center gap-2.5 transition-all duration-300">
            <i id="alertIcon" class="fas fa-circle-info text-base shrink-0"></i>
            <span id="alertMsg"></span>
        </div>

        <!-- STEP 1: Enter Gmail -->
        <div id="stepEmail" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                    <i class="fas fa-envelope text-cyan-400 mr-1"></i> Registered Gmail Address
                </label>
                <input type="email" id="resetEmail" required placeholder="name@gmail.com" 
                    class="w-full bg-[#1e293b]/70 border border-slate-700 focus:border-cyan-400 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 transition">
            </div>

            <button type="button" id="btnSendOtp" onclick="handleSendOtp()"
                class="w-full py-3 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 active:scale-[0.99] transition shadow-[0_4px_15px_rgba(6,182,212,0.3)] flex items-center justify-center gap-2">
                <i class="fas fa-paper-plane"></i>
                <span id="btnSendOtpText">Send Verification Code</span>
            </button>
        </div>

        <!-- STEP 2: Enter OTP & New Password (Hidden by default) -->
        <div id="stepReset" class="hidden space-y-4 mt-2">
            <div class="bg-cyan-950/30 border border-cyan-800/40 rounded-xl p-3 text-xs text-cyan-300 flex items-center justify-between">
                <span>Code sent to: <strong id="displayEmail" class="text-white font-mono"></strong></span>
                <button type="button" onclick="switchBackToEmail()" class="text-cyan-400 hover:underline text-[11px] font-bold">Change</button>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider">
                        <i class="fas fa-key text-cyan-400 mr-1"></i> 6-Digit OTP Code
                    </label>
                    <span id="timerText" class="text-[11px] font-mono font-bold text-amber-400">⏱️ 10:00</span>
                </div>
                <input type="text" id="otpCode" maxlength="6" placeholder="• • • • • •" 
                    class="w-full bg-[#1e293b]/70 border border-slate-700 focus:border-cyan-400 rounded-xl px-4 py-3 text-center text-2xl font-mono font-black text-cyan-400 tracking-[8px] placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 transition">
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                    <i class="fas fa-lock text-cyan-400 mr-1"></i> New Password
                </label>
                <input type="password" id="newPassword" placeholder="Enter at least 4 characters" 
                    class="w-full bg-[#1e293b]/70 border border-slate-700 focus:border-cyan-400 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 transition">
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                    <i class="fas fa-lock-open text-cyan-400 mr-1"></i> Confirm New Password
                </label>
                <input type="password" id="confirmPassword" placeholder="Confirm your new password" 
                    class="w-full bg-[#1e293b]/70 border border-slate-700 focus:border-cyan-400 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 transition">
            </div>

            <button type="button" id="btnResetPassword" onclick="handleVerifyAndReset()"
                class="w-full py-3 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 active:scale-[0.99] transition shadow-[0_4px_15px_rgba(16,185,129,0.3)] flex items-center justify-center gap-2">
                <i class="fas fa-check-circle"></i>
                <span id="btnResetText">Confirm & Update Password</span>
            </button>

            <div class="text-center pt-2">
                <button type="button" id="btnResend" onclick="handleSendOtp(true)" disabled
                    class="text-xs text-slate-400 hover:text-cyan-400 disabled:opacity-40 disabled:hover:text-slate-400 font-semibold transition">
                    Didn't receive code? Resend in (<span id="resendCountdown">60</span>s)
                </button>
            </div>
        </div>

        <!-- Back to Login Navigation -->
        <div class="mt-6 pt-5 border-t border-slate-800 text-center text-xs text-slate-400 flex items-center justify-between">
            <a href="/login" class="text-cyan-400 hover:text-cyan-300 font-bold inline-flex items-center gap-1.5 transition">
                <i class="fas fa-arrow-left"></i> Back to Login
            </a>
            <a href="/register" class="text-pink-400 hover:text-pink-300 font-bold transition">
                Create Account
            </a>
        </div>
    </div>
</div>

<script>
    let activeEmail = '';
    let expiryInterval = null;
    let resendInterval = null;

    function showAlert(type, msg) {
        const box = document.getElementById('alertBox');
        const icon = document.getElementById('alertIcon');
        const msgEl = document.getElementById('alertMsg');

        box.className = 'mb-5 p-3.5 rounded-xl text-xs font-semibold flex items-center gap-2.5 transition-all duration-300';
        
        if (type === 'error') {
            box.classList.add('bg-rose-950/60', 'border', 'border-rose-700/60', 'text-rose-200');
            icon.className = 'fas fa-circle-exclamation text-base text-rose-400 shrink-0';
        } else if (type === 'success') {
            box.classList.add('bg-emerald-950/60', 'border', 'border-emerald-700/60', 'text-emerald-200');
            icon.className = 'fas fa-circle-check text-base text-emerald-400 shrink-0';
        } else {
            box.classList.add('bg-cyan-950/60', 'border', 'border-cyan-700/60', 'text-cyan-200');
            icon.className = 'fas fa-info-circle text-base text-cyan-400 shrink-0';
        }

        msgEl.innerText = msg;
        box.classList.remove('hidden');
    }

    function hideAlert() {
        document.getElementById('alertBox').classList.add('hidden');
    }

    async function handleSendOtp(isResend = false) {
        hideAlert();
        const emailInput = document.getElementById('resetEmail');
        const email = (isResend ? activeEmail : emailInput.value).trim().toLowerCase();

        if (!email || !email.includes('@')) {
            showAlert('error', 'অনুগ্রহ করে একটি সঠিক Gmail এড্রেস লিখুন।');
            return;
        }

        const btn = document.getElementById('btnSendOtp');
        const btnText = document.getElementById('btnSendOtpText');
        const originalText = btnText.innerText;

        btn.disabled = true;
        btnText.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Sending Code...';

        try {
            const res = await fetch('/api/forgot-password/send-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            });
            const data = await res.json();

            if (!res.ok || !data.success) {
                showAlert('error', data.message || 'Error sending code.');
                btn.disabled = false;
                btnText.innerText = originalText;
                return;
            }

            activeEmail = email;
            showAlert('success', data.message || 'Verification code sent to your Gmail!');

            // Transition to Step 2
            document.getElementById('stepEmail').classList.add('hidden');
            document.getElementById('stepReset').classList.remove('hidden');
            document.getElementById('displayEmail').innerText = activeEmail;
            document.getElementById('otpCode').focus();

            start10MinTimer();
            startResendCooldown();
        } catch (err) {
            console.error(err);
            showAlert('error', 'নেটওয়ার্ক সমস্যা অথবা সার্ভার রেসপন্স করছে না।');
        } finally {
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }

    function switchBackToEmail() {
        document.getElementById('stepReset').classList.add('hidden');
        document.getElementById('stepEmail').classList.remove('hidden');
        hideAlert();
        clearInterval(expiryInterval);
        clearInterval(resendInterval);
    }

    function start10MinTimer() {
        clearInterval(expiryInterval);
        let secondsLeft = 10 * 60;
        const timerEl = document.getElementById('timerText');

        expiryInterval = setInterval(() => {
            secondsLeft--;
            if (secondsLeft <= 0) {
                clearInterval(expiryInterval);
                timerEl.innerText = '⏱️ Expired';
                timerEl.className = 'text-[11px] font-mono font-bold text-rose-400';
                showAlert('error', 'Verification code expired. Please request a new code.');
                return;
            }
            const m = Math.floor(secondsLeft / 60);
            const s = secondsLeft % 60;
            timerEl.innerText = `⏱️ ${m}:${s < 10 ? '0' : ''}${s}`;
        }, 1000);
    }

    function startResendCooldown() {
        clearInterval(resendInterval);
        const resendBtn = document.getElementById('btnResend');
        const cdSpan = document.getElementById('resendCountdown');
        let cd = 60;

        resendBtn.disabled = true;
        cdSpan.innerText = cd;

        resendInterval = setInterval(() => {
            cd--;
            cdSpan.innerText = cd;
            if (cd <= 0) {
                clearInterval(resendInterval);
                resendBtn.disabled = false;
                resendBtn.innerHTML = '<i class="fas fa-redo-alt mr-1"></i> Resend Verification Code';
            }
        }, 1000);
    }

    async function handleVerifyAndReset() {
        hideAlert();
        const otp = document.getElementById('otpCode').value.trim();
        const newPassword = document.getElementById('newPassword').value.trim();
        const confirmPassword = document.getElementById('confirmPassword').value.trim();

        if (!otp || otp.length < 6) {
            showAlert('error', 'অনুগ্রহ করে জিমেইলে আসা ৬ ডিজিটের কোডটি দিন।');
            return;
        }

        if (!newPassword || newPassword.length < 4) {
            showAlert('error', 'পাসওয়ার্ড কমপক্ষে ৪ অক্ষরের হতে হবে।');
            return;
        }

        if (newPassword !== confirmPassword) {
            showAlert('error', 'পাসওয়ার্ড এবং কনফার্ম পাসওয়ার্ড মিলছে না।');
            return;
        }

        const btn = document.getElementById('btnResetPassword');
        const btnText = document.getElementById('btnResetText');
        const originalText = btnText.innerText;

        btn.disabled = true;
        btnText.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Updating Password...';

        try {
            const res = await fetch('/api/forgot-password/verify-and-reset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    email: activeEmail,
                    otp: otp,
                    newPassword: newPassword
                })
            });

            const data = await res.json();

            if (!res.ok || !data.success) {
                showAlert('error', data.message || 'Verification failed.');
                btn.disabled = false;
                btnText.innerText = originalText;
                return;
            }

            showAlert('success', 'পাসওয়ার্ড সফলভাবে পরিবর্তন করা হয়েছে! রিডাইরেক্ট করা হচ্ছে...');
            btnText.innerHTML = '<i class="fas fa-check mr-1"></i> Success! Logging in...';

            setTimeout(() => {
                window.location.href = '/account';
            }, 1200);
        } catch (err) {
            console.error(err);
            showAlert('error', 'নেটওয়ার্ক সমস্যা অথবা সার্ভার এরর হয়েছে।');
            btn.disabled = false;
            btnText.innerText = originalText;
        }
    }
</script>

<%- include('partials/footer') %>