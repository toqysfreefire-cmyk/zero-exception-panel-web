<%- include('partials/header') %>

<div class="container mx-auto px-4 py-8 max-w-lg">
    <div class="login-form mx-auto bg-white" style="border: 1px solid #bed4fb; border-radius: 12px; padding: 28px 32px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);">
        <div class="w-auto px-0 pt-1 pb-1">
            <h1 class="text-2xl font-bold text-gray-900 mb-2">Register</h1>

            <!-- Google Register Button -->
            <div class="my-4 text-center">
                <a href="/auth/google" class="flex items-center justify-center w-full px-4 py-2.5 bg-white border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none transition">
                    <img src="https://www.google.com/favicon.ico" alt="Google" class="w-4 h-4 mr-2">
                    Register with Google
                </a>
            </div>

            <!-- Divider -->
            <div class="flex justify-between items-center my-4">
                <hr class="w-1/4 border-gray-200">
                <span class="text-gray-400 w-auto font-primary text-xs px-2 lowercase">sign up with credentials</span>
                <hr class="w-1/4 border-gray-200">
            </div>

            <% if (error) { %>
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg flex items-center gap-2">
                <i class="fas fa-circle-exclamation text-base shrink-0"></i>
                <span><%= error %></span>
            </div>
            <% } %>

            <!-- Form -->
            <form action="/register" method="POST">
                <div class="relative py-1.5">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Full Name</label>
                    <input type="text" id="username" name="name" required placeholder="Name" class="form-input block w-full border border-gray-300 rounded-md text-sm px-3 py-2.5 shadow-sm bg-transparent text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <div class="relative py-1.5">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Phone</label>
                    <input type="text" id="phone" name="phone" required placeholder="Phone (e.g. 01700000000)" class="form-input block w-full border border-gray-300 rounded-md text-sm px-3 py-2.5 shadow-sm bg-transparent text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <div class="relative py-1.5">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Email</label>
                    <input type="email" id="email" name="email" required placeholder="Email" class="form-input block w-full border border-gray-300 rounded-md text-sm px-3 py-2.5 shadow-sm bg-transparent text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <div class="relative py-1.5">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Password</label>
                    <input type="password" id="password" name="password" required placeholder="Password" class="form-input block w-full border border-gray-300 rounded-md text-sm px-3 py-2.5 shadow-sm bg-transparent text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <div class="relative py-1.5">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Confirm Password</label>
                    <input type="password" id="confirm_password" name="password_confirmation" required placeholder="Confirm Password" class="form-input block w-full border border-gray-300 rounded-md text-sm px-3 py-2.5 shadow-sm bg-transparent text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <!-- Submit Button -->
                <div class="text-center mt-4">
                    <button type="submit" class="justify-center font-medium rounded-md text-sm px-4 py-2.5 shadow-sm text-white w-full text-center transition" style="background-color: #008c09; border-color: #008c09;">
                        Register
                    </button>
                </div>
            </form>
        </div>

        <div class="mt-4 pt-4 border-t border-gray-100 text-center text-xs text-gray-600">
            Already member?
            <a href="/login" class="text-pink-500 font-bold hover:underline">Login</a> Now
        </div>
    </div>
</div>

<%- include('partials/footer') %>
