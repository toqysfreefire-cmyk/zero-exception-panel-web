                        </div>

                        <!-- Rank 2 -->
                        <div class="activity-item d-flex align-items-center justify-content-between p-3 rounded-xl">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-box" style="border: 2px solid #94a3b8; box-shadow: 0 0 10px rgba(148, 163, 184, 0.45);">
                                    <img src="/uploads/avatar/4500.jpg" alt="Rifat Ahmed" loading="lazy">
                                    <span class="rank-badge" style="border-color: #94a3b8 !important;">🥈</span>
                                </div>
                                <div>
                                    <h4 class="text-white font-bold text-sm mb-1 d-flex align-items-center gap-1">
                                        Rifat Ahmed
                                        <i class="fas fa-check-circle" style="color: #00f0ff; font-size: 11px;" title="Verified Reseller"></i>
                                    </h4>
                                    <span class="buyer-badge" style="background: rgba(0, 240, 255, 0.15); color: #00f0ff; border: 1px solid rgba(0, 240, 255, 0.4);">
                                        ⭐ ELITE RESELLER
                                    </span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="buyer-amount" style="color: #00f0ff; font-size: 15px; text-shadow: 0 0 10px rgba(0, 240, 255, 0.45);">31,500৳</span>
                            </div>
                        </div>

                        <!-- Rank 3 -->
                        <div class="activity-item d-flex align-items-center justify-content-between p-3 rounded-xl">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-box" style="border: 2px solid #f97316; box-shadow: 0 0 10px rgba(249, 115, 22, 0.45);">
                                    <img src="/uploads/avatar/5341.jpg" alt="Tanvir FF" loading="lazy">
                                    <span class="rank-badge" style="border-color: #f97316 !important;">🥉</span>
                                </div>
                                <div>
                                    <h4 class="text-white font-bold text-sm mb-1 d-flex align-items-center gap-1">
                                        Tanvir FF
                                        <i class="fas fa-check-circle" style="color: #00f0ff; font-size: 11px;" title="Verified Buyer"></i>
                                    </h4>
                                    <span class="buyer-badge" style="background: rgba(255, 0, 127, 0.15); color: #ff007f; border: 1px solid rgba(255, 0, 127, 0.4);">
                                        💎 VIP BUYER
                                    </span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="buyer-amount" style="color: #ff007f; font-size: 15px; text-shadow: 0 0 10px rgba(255, 0, 127, 0.45);">24,890৳</span>
                            </div>
                        </div>

                        <!-- Rank 4 -->
                        <div class="activity-item d-flex align-items-center justify-content-between p-3 rounded-xl">
                            <div class="d-flex align-items-center gap-3">
