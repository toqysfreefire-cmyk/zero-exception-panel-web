                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill text-xs font-bold">Success</span>
                        </div>

                        <div class="activity-item d-flex align-items-center justify-content-between p-3 rounded-xl bg-gray-50 border border-gray-100">
                            <div class="d-flex align-items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-black">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div>
                                    <h4 class="text-gray-800 font-bold text-sm mb-0">PHANTOM ANDROID-IOS (1 Day)</h4>
                                    <span class="text-xs text-gray-500">Player ID: 59302194 • 12 mins ago</span>
                                </div>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill text-xs font-bold">Success</span>
                        </div>
                    </div>
                </div>

                <!-- Feedbacks Tab -->
