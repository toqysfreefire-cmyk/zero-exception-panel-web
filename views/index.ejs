                    </div>
                </div>

                <!-- Recent Orders Tab -->
                <div class="tab-content" id="list-recent-orders" style="display: none;">
                    <div class="d-flex flex-column gap-3">
                        <div class="activity-item d-flex align-items-center justify-content-between p-3 rounded-xl bg-gray-50 border border-gray-100">
