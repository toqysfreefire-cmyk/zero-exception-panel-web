<%- include('partials/header') %>

<div class="container mx-auto px-4 py-10 max-w-lg">
    <div class="login-form mx-auto bg-white" style="border: 1px solid #bed4fb; border-radius: 12px; padding: 28px 32px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);">
        <div class="w-auto px-0 pt-1 pb-1">
            <h1 class="text-2xl font-bold text-gray-900 mb-2">Login</h1>

            <!-- Google Login Button -->
            <div class="my-4 text-center">
                <a href="/auth/google" class="flex items-center justify-center w-full px-4 py-2.5 bg-white border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none transition">
                    <img src="https://www.google.com/favicon.ico" alt="Google" class="w-4 h-4 mr-2">
                    Login with Google
                </a>
            </div>

            <!-- Divider -->
            <div class="flex justify-between items-center my-4">
                <hr class="w-1/4 border-gray-200">
                <span class="text-gray-400 w-auto font-primary text-xs px-2 lowercase">sign in with credentials</span>
                <hr class="w-1/4 border-gray-200">
            </div>

            <% if (error) { %>
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg flex items-center gap-2">
                <i class="fas fa-circle-exclamation text-base shrink-0"></i>
                <span><%= error %></span>
            </div>
            <% } %>

            <!-- Form -->
            <form action="/login" method="POST">
                <div class="my-3 relative">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Email</label>
                    <input type="text" name="email" required placeholder="Email" class="form-input relative block w-full border border-gray-300 rounded-md text-sm px-3 py-2.5 shadow-sm bg-transparent text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <div class="my-3 relative">
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Password</label>
                    <input type="password" name="password" required placeholder="Password" class="form-input relative block w-full border border-gray-300 rounded-md text-sm px-3 py-2.5 shadow-sm bg-transparent text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="my-3 flex items-center justify-between text-xs">
                    <label class="flex items-center cursor-pointer text-gray-600">
                        <input id="remember_me" name="remember" type="checkbox" class="rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                        <span class="ml-2">Remember me</span>
                    </label>
                    <a href="/forgot-password" class="text-pink-500 hover:underline">Forget Password?</a>
                </div>

                <!-- Submit Button -->
                <div class="text-center mt-4">
                    <button type="submit" name="signin" class="justify-center font-medium rounded-md text-sm px-4 py-2.5 shadow-sm text-white w-full text-center transition" style="background-color: #008c09; border-color: #008c09;">
                        Login
                    </button>
                </div>
            </form>
        </div>

        <div class="mt-4 pt-4 border-t border-gray-100 text-center text-xs text-gray-600">
            New user to Buy Panel and Apk Mod Easily?
            <a href="/register" class="text-pink-500 font-bold hover:underline">Register</a> Now
        </div>

        <div class="mt-3 text-center">
            <a href="/admin/login" class="text-xs text-emerald-700 hover:text-emerald-800 font-bold inline-flex items-center gap-1.5 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-3 py-1.5 rounded-lg transition text-decoration-none">
                <i class="fas fa-shield-alt"></i> Access Admin Portal
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
