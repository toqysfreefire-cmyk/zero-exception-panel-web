<%- include('partials/header') %>

<%
var isRoot = (product.id === 26) || (product.slug === 'root-service') || (product.title && product.title.toLowerCase().includes('root service-with phone'));
var isRootService = (product.id === 25 || product.id === 26 || (product.slug && product.slug.toLowerCase().includes('root-service')));
var isAccount = (product.category === 'accounts') || (product.slug && product.slug.toLowerCase().includes('account')) || (product.title && product.title.toLowerCase().includes('free fire account'));
var whatsAppNumber = settings.whatsapp_number || '01727400370';
var whatsAppIntl = settings.whatsapp_intl || '8801727400370';
var paymentNumber = settings.payment_number || '01700878400';

var pMethods = (settings && settings.payment_methods) || {};
var bkashInfo = pMethods.bkash || { active: true, name: 'bKash', number: paymentNumber, type: 'Personal' };
var nagadInfo = pMethods.nagad || { active: true, name: 'Nagad', number: paymentNumber, type: 'Personal' };
var rocketInfo = pMethods.rocket || { active: true, name: 'Rocket', number: paymentNumber, type: 'Personal' };
var binanceInfo = pMethods.binance || { active: true, name: 'Binance USDT', number: 'Pay ID: 1290554507', type: 'Crypto' };

var availablePaymentGateways = [];
if (bkashInfo && bkashInfo.active !== false) {
    availablePaymentGateways.push({
        id: 'bKash',
        name: bkashInfo.name || 'bKash',
        number: bkashInfo.number || paymentNumber,
        sub: (bkashInfo.type || 'Personal') + ' Send Money',
        note: 'Send Money (Personal)',
        color: '#ff007f',
        cssClass: 'method-name-bkash',
        placeholder: 'Enter bKash TrxID (e.g. 9J4K7L8M)',
        help: 'Copy the TrxID from your bKash confirmation SMS and paste it here.'
    });
}
if (nagadInfo && nagadInfo.active !== false) {
    availablePaymentGateways.push({
        id: 'Nagad',
        name: nagadInfo.name || 'Nagad',
        number: nagadInfo.number || paymentNumber,
        sub: (nagadInfo.type || 'Personal') + ' Send Money',
        note: 'Send Money (Personal)',
        color: '#ff7700',
        cssClass: 'method-name-nagad',
        placeholder: 'Enter Nagad TrxID (e.g. 7K2M9X1A)',
        help: 'Copy the TrxID from your Nagad confirmation SMS and paste it here.'
    });
}
if (rocketInfo && rocketInfo.active !== false) {
    availablePaymentGateways.push({
        id: 'Rocket',
        name: rocketInfo.name || 'Rocket',
        number: rocketInfo.number || paymentNumber,
        sub: (rocketInfo.type || 'Personal') + ' Send Money',
        note: 'Send Money (Personal)',
        color: '#8b5cf6',
        cssClass: 'method-name-rocket',
        placeholder: 'Enter Rocket Transaction ID',
        help: 'Copy the Transaction ID from your Rocket confirmation SMS and paste it here.'
    });
}
if (binanceInfo && binanceInfo.active !== false) {
    availablePaymentGateways.push({
        id: 'Binance',
        name: binanceInfo.name || 'Binance USDT',
        number: binanceInfo.number || 'Pay ID: 1290554507',
        sub: (binanceInfo.type || 'Crypto') + ' Pay ID / Transfer',
        note: 'Crypto / USDT Pay ID',
        color: '#f0b90b',
        cssClass: 'method-name-binance',
        placeholder: 'Enter Binance Pay ID / TxID / Order ID',
        help: 'Send USDT via Binance Pay ID or TRC20, then paste your Pay ID or Transaction Hash here.'
    });
}

var userWalletBal = (currentUser && currentUser.wallet_balance) ? parseFloat(currentUser.wallet_balance) : 0;
if (currentUser) {
    availablePaymentGateways.push({
        id: 'Wallet Balance',
        name: 'Store Wallet',
        number: 'Available: ' + userWalletBal + '৳',
        sub: userWalletBal + '৳ Available',
        note: 'Instant 1-Click Pay',
        color: '#10b981',
        cssClass: 'method-name-wallet',
        placeholder: 'Paid via Wallet (Auto Deducted)',
        help: 'Order will be placed instantly and automatically deducted from your store wallet balance.'
    });
}

if (availablePaymentGateways.length === 0) {
    availablePaymentGateways.push({
        id: 'bKash',
        name: 'bKash',
        number: paymentNumber,
        sub: 'Personal Send Money',
        note: 'Send Money (Personal)',
        color: '#ff007f',
        cssClass: 'method-name-bkash',
        placeholder: 'Enter bKash TrxID',
        help: 'Copy the TrxID from your confirmation SMS and paste it here.'
    });
}
var initialGateway = availablePaymentGateways[0];

function normalizeDurationOption(option, productItem) {
    if (!option) return null;
    if (typeof option === 'string') {
        var splitValue = option.split('|');
        var days = parseInt(splitValue[0], 10);
        var price = parseFloat(splitValue[1]);
        if (!Number.isInteger(days) || days < 1 || isNaN(price) || price < 0) return null;
        return { days: days, label: days + (days === 1 ? ' Day Key' : ' Days Key'), price: price };
    }

    var label = option.label || option.name || option.title || option.variant || '';
    var days = Number(option.days);
    var price = Number(option.price);
    if (!Number.isFinite(price)) {
        var mult = Number(option.multiplier || option.value || 1);
        price = Math.round((Number(productItem && productItem.price) || 0) * (Number.isFinite(mult) && mult > 0 ? mult : 1));
    }

    if (Number.isInteger(days) && days > 0) {
        return {
            days: days,
            label: days + (days === 1 ? ' Day Key' : ' Days Key'),
            price: price
        };
    }
    return label ? { label: label.trim(), price: price } : null;
}

function getDurationOptionsForProduct(productItem) {
    var rawOptions = productItem && productItem.duration_options;
    var basePrice = Number(productItem && productItem.price) || 0;

    if (productItem && (productItem.category === 'accounts' || (productItem.slug && productItem.slug.toLowerCase().includes('account')))) {
        return [
            { label: 'Full Account Access (Permanent)', price: Math.round(basePrice) }
        ];
    }

    var fallback = [
        { days: 1, label: '1 Day Key', price: Math.round(basePrice) },
        { days: 7, label: '7 Days Key', price: Math.round(basePrice * 3.5) },
        { days: 30, label: '30 Days Key', price: Math.round(basePrice * 10) }
    ];

    if (productItem && productItem.category && productItem.category.toLowerCase().includes('root-service')) {
        fallback = [
            { label: 'Standard Device Rooting', price: Math.round(basePrice) },
            { label: 'Root + Gaming Kernel (120 FPS)', price: Math.round(basePrice * 1.35) },
            { label: 'VIP Root + Anti-Ban Suite', price: Math.round(basePrice * 1.75) }
        ];
    }

    var options = [];
    if (Array.isArray(rawOptions)) {
        options = rawOptions.map(function(option) {
            return normalizeDurationOption(option, productItem);
        }).filter(Boolean);
    } else if (typeof rawOptions === 'string' && rawOptions.trim()) {
        try {
            var parsedOptions = JSON.parse(rawOptions);
            if (Array.isArray(parsedOptions)) {
                options = parsedOptions.map(function(option) {
                    return normalizeDurationOption(option, productItem);
                }).filter(Boolean);
            }
        } catch (error) {
            options = rawOptions.split(/\r?\n/).map(function(option) {
                return normalizeDurationOption(option, productItem);
            }).filter(Boolean);
        }
    }

    return options.length ? options : fallback;
}

var durationOptions = getDurationOptionsForProduct(product);
%>

