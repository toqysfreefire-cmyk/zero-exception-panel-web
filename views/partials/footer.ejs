    <!-- Maintenance Notice Modal -->
    <div class="modal fade" id="maintenanceNoticeModal" tabindex="-1" aria-labelledby="maintenanceNoticeTitleText" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2xl border-0 overflow-hidden shadow-2xl">
                <div class="modal-header bg-amber-500 text-white border-0 py-3 px-4">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-triangle-exclamation text-xl"></i>
                        <h5 class="modal-title font-bold text-white text-md uppercase" id="maintenanceNoticeTitleText">
                            Under Maintenance
                        </h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-2 text-2xl">
                            <i class="fas fa-tools"></i>
                        </div>
                        <h4 class="font-bold text-gray-900 text-base" id="maintenanceProductSubTitle">Product Offline</h4>
                    </div>

                    <div id="maintenanceMessageContainer" class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs md:text-sm text-gray-800 leading-relaxed whitespace-pre-line max-h-64 overflow-y-auto font-medium">
                        This panel is currently offline for updating.
                    </div>
                </div>
                <div class="modal-footer border-0 bg-gray-50 px-4 py-3">
                    <button type="button" class="btn btn-warning w-full rounded-xl py-2 font-bold text-sm text-white" style="background: #f59e0b;" data-bs-dismiss="modal">
                        Understood
                    </button>
                </div>
            </div>
        </div>
