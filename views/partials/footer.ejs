<!-- JavaScript Assets -->
<script src="/assets/js/jquery-3.7.1.min.js"></script>
<script src="/assets/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/toastr.min.js"></script>
<script src="/assets/js/slider.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. Force reveal all products immediately
    document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
        el.classList.add('is-visible');
        el.style.opacity = '1';
        el.style.transform = 'none';
        el.style.visibility = 'visible';
    });

    // 2. Currency dropdown toggle (Robust)
    var currSwitch = document.getElementById('currencySwitch');
    var pillBtn = document.getElementById('currencyPillBtn');
    var menu = document.getElementById('currencyMenu');

    if (pillBtn && menu) {
        pillBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var isOpen = menu.classList.contains('show') || (currSwitch && currSwitch.classList.contains('is-open'));
            if (isOpen) {
                menu.classList.remove('show');
                if (currSwitch) currSwitch.classList.remove('is-open');
            } else {
                menu.classList.add('show');
                if (currSwitch) currSwitch.classList.add('is-open');
            }
        });

        document.addEventListener('click', function(e) {
            if (!menu.contains(e.target) && !pillBtn.contains(e.target)) {
                menu.classList.remove('show');
                if (currSwitch) currSwitch.classList.remove('is-open');
            }
        });
    }

    // 3. User account dropdown toggle
    var userToggles = document.querySelectorAll('.user-menu-toggle');
    userToggles.forEach(function(btn) {
        var wrap = btn.closest('.user-dropdown-wrap');
        var userMenu = wrap ? wrap.querySelector('.user-dropdown-menu') : null;
        if (userMenu) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                userMenu.classList.toggle('show');
            });
            document.addEventListener('click', function(e) {
                if (!wrap.contains(e.target)) {
                    userMenu.classList.remove('show');
                }
            });
        }
    });

    // 4. Setup & Download Modal Handler
    document.querySelectorAll('.info-download-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var title = this.getAttribute('data-title') || 'Product Details';
            var setup = (this.getAttribute('data-setup') || '').trim();
            var apk = (this.getAttribute('data-apk') || '').trim();
            var feedback = (this.getAttribute('data-feedback') || '').trim();

            document.getElementById('modalProductTitle').textContent = title;
            document.getElementById('modalProductTitleBody').textContent = title;

            var isValid = function(val) {
                return val && val !== '#' && val !== 'null' && val !== 'undefined' && val !== '""' && val !== "''";
            };

            var setupBtn = document.getElementById('modalSetupVideoBtn');
            var apkBtn = document.getElementById('modalApkDownloadBtn');
            var feedbackBtn = document.getElementById('modalFeedbackBtn');
            var emptyNotice = document.getElementById('modalEmptyNotice');

            var hasAny = false;

            if (setupBtn) {
                if (isValid(setup)) {
                    setupBtn.href = setup;
                    setupBtn.style.display = 'flex';
                    hasAny = true;
                } else {
                    setupBtn.style.display = 'none';
                }
            }

            if (apkBtn) {
                if (isValid(apk)) {
                    apkBtn.href = apk;
                    apkBtn.style.display = 'flex';
                    hasAny = true;
                } else {
                    apkBtn.style.display = 'none';
                }
            }

            if (feedbackBtn) {
                if (isValid(feedback)) {
                    feedbackBtn.href = feedback;
                    feedbackBtn.style.display = 'flex';
                    hasAny = true;
                } else {
                    feedbackBtn.style.display = 'none';
                }
            }

            if (emptyNotice) {
                emptyNotice.style.display = hasAny ? 'none' : 'block';
            }

            var modal = new bootstrap.Modal(document.getElementById('setupDownloadModal'));
            modal.show();
        });
    });

    // 5. Maintenance Notice Modal Handler
    document.querySelectorAll('.js-maintenance-notice').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var title = this.getAttribute('data-notice-title') || 'Notice';
            var msg = this.getAttribute('data-notice-message') || 'This product is currently offline for updating.';

            document.getElementById('maintenanceProductSubTitle').textContent = title;
            document.getElementById('maintenanceMessageContainer').textContent = msg;

            var modal = new bootstrap.Modal(document.getElementById('maintenanceNoticeModal'));
            modal.show();
        });
    });

    // 6. Category filter and Search interactions (Unified Engine)
    var filterBtns = document.querySelectorAll('.filter-btn');
    var extraFilters = document.getElementById('extra-filters');
    var toggleBtn = document.getElementById('toggle-filters-btn');
    var toggleText = document.getElementById('toggle-text');
    var toggleIcon = document.getElementById('toggle-icon');
    var searchInput = document.getElementById('productSearchInput');
    var clearSearchBtn = document.getElementById('clearSearchBtn');
    var resetFiltersBtn = document.getElementById('resetFiltersBtn');
    var noProductsFound = document.getElementById('noProductsFound');

    var currentCategoryFilter = 'all';
    var currentSearchTerm = '';

    function filterProducts() {
        var items = document.querySelectorAll('.product-item');
        var visibleCount = 0;

        items.forEach(function(item) {
            var itemCategory = item.getAttribute('data-category') || '';
            var itemTitle = item.getAttribute('data-title') || '';
            if (!itemTitle) {
                var titleEl = item.querySelector('.product-title-full');
                itemTitle = titleEl ? titleEl.textContent.toLowerCase() : '';
            }

            var matchesCategory = (currentCategoryFilter === 'all') ||
                                  (itemCategory === currentCategoryFilter) ||
                                  item.classList.contains(currentCategoryFilter);

            var matchesSearch = !currentSearchTerm || itemTitle.includes(currentSearchTerm);

            if (matchesCategory && matchesSearch) {
                item.classList.remove('is-hidden');
                item.style.display = 'flex';
                item.style.opacity = '1';
                item.style.visibility = 'visible';
                visibleCount++;
            } else {
                item.classList.add('is-hidden');
                item.style.display = 'none';
            }
        });

        if (noProductsFound) {
            noProductsFound.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    }

    // Category button clicks
    filterBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            filterBtns.forEach(function(b) { b.classList.remove('active-filter'); });
            this.classList.add('active-filter');

            currentCategoryFilter = this.getAttribute('data-filter') || 'all';
            filterProducts();
        });
    });

    // More / Less Toggle
    if (toggleBtn && extraFilters) {
        toggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            var isOpen = extraFilters.classList.toggle('is-open');
            if (isOpen) {
                extraFilters.style.display = 'grid';
                if (toggleText) toggleText.textContent = 'Less';
                if (toggleIcon) toggleIcon.style.transform = 'rotate(180deg)';
                toggleBtn.setAttribute('aria-expanded', 'true');
            } else {
                extraFilters.style.display = 'none';
                if (toggleText) toggleText.textContent = 'More';
                if (toggleIcon) toggleIcon.style.transform = 'rotate(0deg)';
                toggleBtn.setAttribute('aria-expanded', 'false');
            }
        });
    }

    // Search input typing
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            currentSearchTerm = this.value.toLowerCase().trim();
            if (clearSearchBtn) {
                clearSearchBtn.style.display = currentSearchTerm ? 'flex' : 'none';
            }
            filterProducts();
        });
    }

    // Clear search button
    if (clearSearchBtn && searchInput) {
        clearSearchBtn.addEventListener('click', function() {
            searchInput.value = '';
            currentSearchTerm = '';
            clearSearchBtn.style.display = 'none';
            searchInput.focus();
            filterProducts();
        });
    }

    // Reset all filters button
    if (resetFiltersBtn) {
        resetFiltersBtn.addEventListener('click', function() {
            if (searchInput) {
                searchInput.value = '';
                currentSearchTerm = '';
            }
            if (clearSearchBtn) clearSearchBtn.style.display = 'none';

            currentCategoryFilter = 'all';
            filterBtns.forEach(function(b) {
                if (b.getAttribute('data-filter') === 'all') {
                    b.classList.add('active-filter');
                } else {
                    b.classList.remove('active-filter');
                }
            });

            filterProducts();
        });
    }

    // 8. Community tabs
    var tabBtns = document.querySelectorAll('.tab-button');
    var tabPanes = document.querySelectorAll('.tab-content');
    tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            tabBtns.forEach(function(b) { b.classList.remove('active-tab'); });
            tabPanes.forEach(function(p) { p.classList.remove('active'); p.style.display = 'none'; });

            this.classList.add('active-tab');
            var tabId = 'list-' + this.getAttribute('data-tab');
            if (this.getAttribute('data-tab') === 'top') tabId = 'list-top-buyers';
            if (this.getAttribute('data-tab') === 'recent') tabId = 'list-recent-orders';
            if (this.getAttribute('data-tab') === 'feedbacks') tabId = 'list-feedbacks';

            var activePane = document.getElementById(tabId);
            if (activePane) {
                activePane.classList.add('active');
                activePane.style.display = 'block';
            }
        });
    });

    // ============================================================
    // FEATURE 1: LIVE SUPPORT DRAWER TOGGLE & SENDER
    // ============================================================
    var supportToggleBtn = document.getElementById('liveSupportToggleBtn');
    var supportCard = document.getElementById('liveSupportCard');
    var supportCloseBtn = document.getElementById('liveSupportCloseBtn');
    var supportForm = document.getElementById('liveSupportQuickForm');
    var supportInput = document.getElementById('liveSupportInput');

    if (supportToggleBtn && supportCard) {
        supportToggleBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            var isOpen = supportCard.style.display === 'block';
            supportCard.style.display = isOpen ? 'none' : 'block';
        });
    }
    if (supportCloseBtn && supportCard) {
        supportCloseBtn.addEventListener('click', function() {
            supportCard.style.display = 'none';
        });
    }
    document.addEventListener('click', function(e) {
        if (supportCard && supportCard.style.display === 'block') {
            if (!supportCard.contains(e.target) && (!supportToggleBtn || !supportToggleBtn.contains(e.target))) {
                supportCard.style.display = 'none';
            }
        }
    });
    if (supportForm && supportInput) {
        supportForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var msg = supportInput.value.trim();
            if (!msg) return;
            var waIntl = '<%= settings.whatsapp_intl %>';
            window.open('https://wa.me/' + waIntl + '?text=' + encodeURIComponent(msg), '_blank');
            supportInput.value = '';
            if (supportCard) supportCard.style.display = 'none';
        });
    }

    // ============================================================
    // FEATURE 5: SOCIAL PROOF RECENT PURCHASE POP-UP
    // ============================================================
    var spPopup = document.getElementById('socialProofPopup');
    var spBuyer = document.getElementById('spBuyer');
    var spProduct = document.getElementById('spProduct');
    var spTime = document.getElementById('spTime');
    var spClose = document.getElementById('spCloseBtn');

    var buyersList = [
