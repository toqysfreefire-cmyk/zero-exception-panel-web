            if (data.segments && data.segments.length) {
                spinSegments = data.segments;
                drawLuckyWheel();
            }

            if (data.title && titleElem) titleElem.innerText = data.title;
            if (data.subtitle && subElem) subElem.innerText = data.subtitle;

            if (data.enabled === false) {
                if (statusText) statusText.innerHTML = '<span style="color: #f87171;">⚠️ ফ্রি স্পিন সিস্টেম বর্তমানে বন্ধ রয়েছে।</span>';
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-pause me-2"></i> SYSTEM PAUSED';
                }
                return;
            }

            if (!data.loggedIn) {
                if (statusText) statusText.innerHTML = '<span style="color: #fbbf24;">⚠️ ফ্রি স্পিন পেতে অনুগ্রহ করে <b>লগইন</b> করুন।</span>';
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-sign-in-alt" style="margin-right: 6px;"></i> LOGIN TO SPIN';
                    btn.onclick = function() { window.location.href = '/login?returnUrl=' + encodeURIComponent(window.location.pathname); };
                }
                return;
            }

            if (btn) {
                btn.onclick = triggerLuckySpin;
            }

            if (data.canSpin) {
                var spinCount = data.spinCredits || 0;
                if (statusText) {
                    statusText.innerHTML = '<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;"><span>🎟️ এভেইলেবল স্পিন:</span><b style="color: #34d399; font-size: 13px;">' + spinCount + ' টি প্রস্তুত</b></div><div style="font-size: 10.5px; color: #94a3b8;">ডিপোজিট প্রগ্রেস: ' + (data.depositedProgress || 0) + '/' + (data.depositThreshold || 500) + '৳ • খরচ প্রগ্রেস: ' + (data.spentProgress || 0) + '/' + (data.spendThreshold || 500) + '৳</div>';
                }
                if (btn) {
                    btn.disabled = false;
                    btn.style.opacity = '1';
                    btn.style.cursor = 'pointer';
                    btn.innerHTML = '<i class="fas fa-play" style="margin-right: 6px;"></i> SPIN NOW (' + spinCount + ' Available)';
                }
            } else {
                var depRem = data.depositRemaining !== undefined ? data.depositRemaining : 500;
                var spdRem = data.spendRemaining !== undefined ? data.spendRemaining : 500;
                if (statusText) {
                    statusText.innerHTML = '<div style="color: #f59e0b; font-weight: bold; margin-bottom: 4px;"><i class="fas fa-ticket-alt"></i> আপনার কোনো স্পিন নেই (০ টি)</div><div style="font-size: 10.5px; color: #cbd5e1; line-height: 1.4;">🎁 প্রতি <b>৫০০৳ ডিপোজিট</b> বা <b>৫০০৳ খরচে</b> ১টি ফ্রি স্পিন পাবেন!<br><span style="color: #38bdf8;">ডিপোজিট বাকি: ' + depRem + '৳</span> | <span style="color: #a855f7;">খরচ বাকি: ' + spdRem + '৳</span></div>';
                }
                if (btn) {
                    btn.disabled = true;
                    btn.style.opacity = '0.5';
                    btn.style.cursor = 'not-allowed';
                    btn.innerHTML = '<i class="fas fa-lock" style="margin-right: 6px;"></i> LOCKED (Deposit/Spend 500৳ to Earn)';
                }
            }
        })
        .catch(function(err) {
            console.error('Spin status check failed:', err);
            drawLuckyWheel();
        });
}

function startSpinCountdown(seconds) {
    if (spinTimerInterval) clearInterval(spinTimerInterval);
    var statusText = document.getElementById('spinStatusText');
    var btn = document.getElementById('btnDoSpin');

    function updateTimer() {
        if (seconds <= 0) {
            clearInterval(spinTimerInterval);
            checkSpinStatus();
            return;
        }
        var h = Math.floor(seconds / 3600);
        var m = Math.floor((seconds % 3600) / 60);
        var s = seconds % 60;
        var formatted = (h < 10 ? '0' + h : h) + 'h ' + (m < 10 ? '0' + m : m) + 'm ' + (s < 10 ? '0' + s : s) + 's';
        if (statusText) {
            statusText.innerHTML = '⏳ পরবর্তী ফ্রি স্পিন এভেইলেবল হবে: <b style="color: #fbbf24; font-family: monospace;">' + formatted + '</b>';
        }
        seconds--;
    }

    updateTimer();
    spinTimerInterval = setInterval(updateTimer, 1000);
}

function triggerLuckySpin() {
    if (isSpinning) return;
    var btn = document.getElementById('btnDoSpin');
    var canvas = document.getElementById('luckyWheelCanvas');
    var prizeCard = document.getElementById('spinPrizeResult');
    if (prizeCard) prizeCard.style.display = 'none';

    isSpinning = true;
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 6px;"></i> SPINNING...';
    }

    fetch('/api/spin/play', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data.success) {
                alert(data.message || 'Error occurred while spinning.');
                isSpinning = false;
                checkSpinStatus();
                return;
            }

            var winningIndex = data.prizeIndex;
            var numSlices = spinSegments.length || 8;
            var sliceDeg = 360 / numSlices;

            // Target alignment with top needle (270 deg)
            var targetAngle = 270 - (winningIndex * sliceDeg + sliceDeg / 2);
            if (targetAngle < 0) targetAngle += 360;

            var totalSpin = 1800 + targetAngle;
            currentWheelRotation = totalSpin;

            canvas.style.transform = 'rotate(' + currentWheelRotation + 'deg)';

            setTimeout(function() {
                isSpinning = false;
                showSpinWinner(data);
                checkSpinStatus();
            }, 5200);
        })
        .catch(function(err) {
            isSpinning = false;
            alert('Spin network error: ' + err.message);
            if (btn) btn.disabled = false;
        });
}

