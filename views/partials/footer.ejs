    <!-- Reseller Tutorial Modal -->
    <div class="modal fade" id="resellerTutorialModal" tabindex="-1" aria-labelledby="tutorialModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-2xl border-0 overflow-hidden shadow-2xl bg-gray-900 text-white">
                <div class="modal-header border-b border-gray-800 py-3 px-4">
                    <h5 class="modal-title font-extrabold text-white text-md uppercase m-0 flex items-center gap-2" id="tutorialModalTitle">
                        <i class="fab fa-youtube text-red-500"></i>
                        <span id="tutorialModalTitleText">Video Tutorial</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 bg-black">
                    <div class="ratio ratio-16x9" id="tutorialEmbedWrap">
                        <iframe id="tutorialVideoFrame" src="" title="Video Player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                </div>
                <div class="modal-footer border-t border-gray-800 py-2 px-4 flex justify-between items-center text-xs text-gray-400">
                    <span id="tutorialVideoHintText">High definition streaming player</span>
                    <button type="button" class="btn btn-secondary btn-sm rounded-lg" data-bs-dismiss="modal">Close</button>
                </div>
