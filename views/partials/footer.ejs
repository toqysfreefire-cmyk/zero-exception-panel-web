function drawLuckyWheel() {
    var canvas = document.getElementById('luckyWheelCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var w = canvas.width;
    var h = canvas.height;
    var cx = w / 2;
    var cy = h / 2;
    var radius = cx - 6;
    var numSlices = spinSegments.length || 8;
    var sliceAngle = (2 * Math.PI) / numSlices;

    ctx.clearRect(0, 0, w, h);

    // Draw Outer Glow Ring
    ctx.beginPath();
    ctx.arc(cx, cy, radius + 3, 0, 2 * Math.PI);
    ctx.lineWidth = 5;
    ctx.strokeStyle = '#f59e0b';
    ctx.stroke();

    for (var i = 0; i < numSlices; i++) {
        var startAngle = i * sliceAngle;
        var endAngle = startAngle + sliceAngle;
        var midAngle = startAngle + sliceAngle / 2;
        var seg = spinSegments[i] || { label: 'Prize ' + (i+1), color: '#38bdf8' };

        // Draw Slice
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, radius, startAngle, endAngle);
        ctx.closePath();
        ctx.fillStyle = seg.color || '#38bdf8';
        ctx.fill();

        // Slice Border
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.stroke();

        // Draw Text radially and cleanly
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(midAngle);
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = '#ffffff';
        ctx.font = '900 11.5px "Orbitron", -apple-system, sans-serif';
        ctx.shadowColor = 'rgba(0, 0, 0, 0.95)';
        ctx.shadowBlur = 4;
        ctx.shadowOffsetX = 1;
        ctx.shadowOffsetY = 1;
        ctx.fillText(seg.label, radius - 16, 0);
        ctx.restore();
    }
}

