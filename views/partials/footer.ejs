                    <!-- TAB 3: MY CARDS -->
                    <div id="gcTabContentMyCards" class="gc-tab-panel hidden">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold text-gray-300">আমার তৈরি করা গিফট কার্ডসমূহ:</span>
                            <button type="button" onclick="loadMyGiftCards()" class="text-[11px] text-cyan-400 hover:text-cyan-300 font-bold flex items-center gap-1 cursor-pointer">
                                <i class="fas fa-sync-alt" id="gcRefreshIcon"></i> রিফ্রেশ
                            </button>
                        </div>
                        <div id="gcMyCardsList" class="space-y-2 max-h-60 overflow-y-auto pr-1">
                            <div class="text-center py-6 text-xs text-gray-400">
                                <i class="fas fa-spinner fa-spin text-cyan-400 text-lg mb-2 block"></i> লোড হচ্ছে...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-t border-cyan-500/20 py-2.5 px-4 bg-slate-950/60">
                    <button type="button" class="btn btn-secondary w-full rounded-xl py-2 font-bold text-xs" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
