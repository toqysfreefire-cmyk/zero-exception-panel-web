        if (typeof toastr !== 'undefined') toastr.warning('সর্বনিম্ন গিফট কার্ড অ্যামাউন্ট ১০৳');
        return;
    }

    var origText = btnText ? btnText.innerText : 'Buy Gift Card';
    if (btn) btn.disabled = true;
    if (btnText) btnText.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> জেনারেট হচ্ছে...';

    try {
        var res = await fetch('/api/gift-cards/purchase', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount: amt })
        });
        var data = await res.json();

        if (data.success) {
            currentGeneratedGiftCode = data.card.code;
            currentGeneratedGiftAmount = data.card.amount;

            if (typeof toastr !== 'undefined') {
                toastr.success(data.message);
            } else {
                alert(data.message);
            }

            // Show success box
            var successBox = document.getElementById('gcPurchaseSuccessBox');
            var codeSpan = document.getElementById('gcSuccessCode');
            var amtSpan = document.getElementById('gcSuccessAmt');
            if (successBox && codeSpan && amtSpan) {
                codeSpan.innerText = data.card.code;
                amtSpan.innerText = data.card.amount + '৳';
                successBox.classList.remove('hidden');
            }

            // Update user wallet balance displays
            if (data.newBalance !== undefined) {
                document.querySelectorAll('.header-wallet-btn b, #gcUserBalanceDisplay, .user-live-wallet').forEach(function(b) {
                    b.innerText = data.newBalance + '৳';
                });
            }

            input.value = '';
            document.querySelectorAll('.gc-amt-btn').forEach(function(b) {
                b.classList.remove('border-cyan-400', 'bg-cyan-500/30', 'text-cyan-300');
            });
        } else {
            if (typeof toastr !== 'undefined') {
                toastr.error(data.message || 'ক্রয় ব্যর্থ হয়েছে');
            } else {
                alert(data.message || 'ক্রয় ব্যর্থ হয়েছে');
            }
        }
    } catch (err) {
        if (typeof toastr !== 'undefined') {
            toastr.error('Error: ' + err.message);
        } else {
            alert('Error: ' + err.message);
        }
    } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.innerText = origText;
    }
}

function copyGiftCardCode(code) {
    var textToCopy = code || currentGeneratedGiftCode;
    if (!textToCopy) return;

    navigator.clipboard.writeText(textToCopy).then(function() {
        var copyBtnText = document.getElementById('gcCopyBtnText');
        if (copyBtnText) copyBtnText.innerText = 'Copied!';
        if (typeof toastr !== 'undefined') {
            toastr.success('কোড ক্লিপবোর্ডে কপি হয়েছে: ' + textToCopy);
        }
        setTimeout(function() {
            if (copyBtnText) copyBtnText.innerText = 'Copy';
        }, 2000);
    }).catch(function() {
        prompt('কোডটি কপি করুন:', textToCopy);
    });
}

function shareGiftCardWhatsApp() {
    if (!currentGeneratedGiftCode) return;
    var message = `🎉 আমি ZERO EXCEPTION থেকে তোমার জন্য ${currentGeneratedGiftAmount}৳ মূল্যের একটি গিফট কার্ড পাঠিয়েছি!\n\n🎁 গিফট কোড: *${currentGeneratedGiftCode}*\n\nসাইটে গিয়ে Redeem করে সরাসরি তোমার ওয়ালেটে ব্যালেন্স নিয়ে নাও:\n${window.location.origin}`;
    var url = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(message);
    window.open(url, '_blank');
}

async function loadMyGiftCards() {
    var list = document.getElementById('gcMyCardsList');
    var icon = document.getElementById('gcRefreshIcon');
    if (icon) icon.classList.add('fa-spin');

    try {
        var res = await fetch('/api/gift-cards/my-cards');
        var data = await res.json();

        if (data.success && data.cards) {
            if (data.cards.length === 0) {
                list.innerHTML = '<div class="text-center py-6 text-xs text-gray-400"><i class="fas fa-gift text-2xl mb-1.5 opacity-40 block"></i>এখনও কোনো গিফট কার্ড কেনা হয়নি।</div>';
            } else {
                var html = '';
                data.cards.forEach(function(c) {
                    var isClaimed = c.claimed;
                    var dateStr = new Date(c.created_at).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short' });
                    html += `
                        <div class="p-2.5 rounded-xl bg-black/60 border ${isClaimed ? 'border-gray-800 opacity-70' : 'border-cyan-500/40'} flex items-center justify-between gap-2">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono font-bold text-xs ${isClaimed ? 'text-gray-400 line-through' : 'text-cyan-300'}">${c.code}</span>
                                    <span class="font-orbitron font-bold text-xs ${isClaimed ? 'text-gray-400' : 'text-emerald-400'}">${c.amount}৳</span>
                                </div>
                                <div class="text-[10px] text-gray-400 mt-0.5">
                                    ${dateStr} • ${isClaimed ? `<span class="text-amber-400">Claimed by ${c.claimed_by || 'User'}</span>` : '<span class="text-emerald-400 font-bold">⚡ Active / Ready to Claim</span>'}
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <button type="button" onclick="copyGiftCardCode('${c.code}')" class="px-2.5 py-1 text-[11px] font-bold rounded-lg ${isClaimed ? 'bg-gray-800 text-gray-400' : 'bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 hover:bg-cyan-500/40'} cursor-pointer">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                        </div>
                    `;
                });
                list.innerHTML = html;
            }
        } else {
            list.innerHTML = `<div class="text-center py-4 text-xs text-gray-400">${data.message || 'লোড করতে সমস্যা হয়েছে। লগইন করেছেন কি?'}</div>`;
        }
    } catch (err) {
        list.innerHTML = `<div class="text-center py-4 text-xs text-red-400">Error: ${err.message}</div>`;
    } finally {
        if (icon) icon.classList.remove('fa-spin');
    }
}

async function handleRedeemGiftCard(e) {
    e.preventDefault();
    var input = document.getElementById('inputGiftCardCode');
    var btn = document.getElementById('btnSubmitRedeem');
    var btnText = document.getElementById('btnRedeemText');
    if (!input || !input.value.trim()) return;

    var code = input.value.trim().toUpperCase();
    var origHtml = btnText ? btnText.innerText : 'Claim';

    if (btn) btn.disabled = true;
    if (btnText) btnText.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Checking code...';

    try {
        var res = await fetch('/api/gift-cards/redeem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code })
        });
        var data = await res.json();

        if (data.success) {
            if (typeof toastr !== 'undefined') {
                toastr.success(data.message);
            } else {
                alert(data.message);
            }
            input.value = '';
            var modalInst = bootstrap.Modal.getInstance(document.getElementById('redeemGiftCardModal'));
            if (modalInst) modalInst.hide();

            // Update wallet in header
            if (data.newBalance !== undefined) {
                document.querySelectorAll('.header-wallet-btn b, #gcUserBalanceDisplay, .user-live-wallet').forEach(function(b) {
                    b.innerText = data.newBalance + '৳';
                });
            }
        } else {
            if (typeof toastr !== 'undefined') {
                toastr.error(data.message || 'Failed to claim code');
            } else {
                alert(data.message || 'Failed to claim code');
            }
        }
    } catch (err) {
        if (typeof toastr !== 'undefined') {
            toastr.error('Network error: ' + err.message);
        } else {
            alert('Error: ' + err.message);
        }
    } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.innerText = origHtml;
    }
}
</script>
</body>
</html>
