                                    <i class="fas fa-check-circle"></i>
                                    <span id="btnBuyGiftText">Buy Gift Card (কার্ড তৈরি করুন)</span>
                                </button>
                            </form>

                            <!-- Success Voucher Box (Hidden by default) -->
                            <div id="gcPurchaseSuccessBox" class="mt-4 p-4 rounded-2xl bg-gradient-to-br from-emerald-950/70 via-black to-cyan-950/70 border-2 border-emerald-400/60 shadow-[0_0_25px_rgba(16,185,129,0.3)] text-center hidden">
                                <span class="badge bg-emerald-500 text-black font-black text-[10px] uppercase px-2 py-0.5 rounded-full mb-2">
                                    🎉 Gift Card Generated!
                                </span>
                                <div class="text-xs text-gray-300 mb-1">কার্ড ভ্যালু: <b class="text-emerald-400 font-orbitron text-sm" id="gcSuccessAmt">0৳</b></div>
                                
                                <div class="p-3 my-2.5 rounded-xl bg-black/80 border border-dashed border-emerald-400 flex items-center justify-between gap-2">
                                    <span class="font-mono font-black text-sm sm:text-base text-cyan-300 tracking-wider truncate" id="gcSuccessCode">ZX-XXXX-XXXX</span>
                                    <button type="button" onclick="copyGiftCardCode()" class="shrink-0 px-3 py-1.5 bg-emerald-500 hover:bg-emerald-400 text-black font-black text-xs rounded-lg transition flex items-center gap-1 cursor-pointer">
                                        <i class="fas fa-copy"></i> <span id="gcCopyBtnText">Copy</span>
                                    </button>
                                </div>

                                <p class="text-[11px] text-gray-300 mb-2">এই কোডটি যে কাউকেই দিলে সে সরাসরি সাইটে রিডিম করে তার ওয়ালেটে টাকা পেয়ে যাবে!</p>
                                <button type="button" onclick="shareGiftCardWhatsApp()" class="inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 font-bold cursor-pointer">
                                    <i class="fab fa-whatsapp"></i> হোয়াটসঅ্যাপে ফ্রেন্ডকে পাঠান
                                </button>
                            </div>
                        <% } else { %>
                            <div class="py-8 text-center">
                                <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-cyan-500/20 border border-cyan-400/40 text-2xl flex items-center justify-center text-cyan-400">
                                    <i class="fas fa-lock"></i>
                                </div>
                                <h4 class="font-bold text-white text-sm mb-1 font-orbitron">লগইন প্রয়োজন</h4>
                                <p class="text-xs text-gray-400 mb-4">গিফট কার্ড কিনতে আপনার অ্যাকাউন্টে লগইন করতে হবে।</p>
                                <a href="/login" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-black text-xs uppercase bg-gradient-to-r from-cyan-400 to-emerald-400 text-black shadow cursor-pointer font-orbitron">
                                    <i class="fas fa-sign-in-alt"></i> লগইন করুন
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <!-- TAB 2: REDEEM CODE -->
                    <div id="gcTabContentRedeem" class="gc-tab-panel hidden text-center">
                        <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-emerald-500/20 border-2 border-emerald-400 text-2xl flex items-center justify-center text-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.4)]">
                            🎁
                        </div>
                        <h4 class="font-black text-white text-base mb-1 font-orbitron">রিডিম করুন গিফট ভাউচার</h4>
                        <p class="text-xs text-gray-300 mb-4">আপনার কাছে থাকা গিফট কার্ড বা প্রোমো কোডটি লিখুন এবং সরাসরি ওয়ালেটে টাকা যোগ করে নিন।</p>

                        <form id="formRedeemGiftCard" onsubmit="handleRedeemGiftCard(event)" class="space-y-3">
                            <div>
                                <input type="text" id="inputGiftCardCode" required placeholder="উদাহরণ: ZX-A9K2-7F8P" class="w-full text-center uppercase tracking-widest font-mono font-black text-base py-3 px-4 rounded-xl bg-black/70 border-2 border-emerald-400/60 text-emerald-300 placeholder:text-gray-500 focus:outline-none focus:border-emerald-300 shadow-inner">
                            </div>
                            <button type="submit" id="btnSubmitRedeem" class="w-full py-3 px-4 rounded-xl font-black text-xs uppercase tracking-wider text-black bg-gradient-to-r from-emerald-400 to-teal-300 hover:from-emerald-300 hover:to-teal-200 shadow-[0_0_20px_rgba(16,185,129,0.4)] transition transform active:scale-95 flex items-center justify-center gap-2 font-orbitron cursor-pointer">
                                <i class="fas fa-check-circle"></i>
                                <span id="btnRedeemText">টাকা যোগ করুন (Claim Code)</span>
                            </button>
