<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Admin Login - <%= settings.site_name %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/png" href="<%= settings.favicon %>">

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #050811;
            background-image: 
                radial-gradient(ellipse at top, rgba(0, 240, 255, 0.12) 0%, transparent 60%),
                radial-gradient(ellipse at bottom, rgba(255, 0, 127, 0.08) 0%, transparent 60%);
            color: #ffffff;
            font-family: 'Rajdhani', sans-serif;
            padding: 20px;
        }
        .login-container {
            width: 100%;
            max-width: 440px;
        }
        .brand-header {
            text-align: center;
            margin-bottom: 24px;
        }
        .brand-icon {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            background: rgba(0, 240, 255, 0.12);
            border: 1.5px solid #00f0ff;
            color: #00f0ff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.35);
            margin-bottom: 12px;
        }
        .brand-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-shadow: 0 0 15px rgba(0, 240, 255, 0.6);
        }
        .brand-sub {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 4px;
        }
        .login-card {
            background: #0a0f22;
            border: 1.5px solid rgba(0, 240, 255, 0.35);
            border-radius: 20px;
            padding: 32px 28px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.9), 0 0 25px rgba(0, 240, 255, 0.15);
        }
        .alert-error {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid #ef4444;
            color: #fca5a5;
            padding: 12px 14px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-label {
            display: block;
            color: #00f0ff;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 8px;
        }
        .input-wrapper {
            position: relative;
        }
        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #00f0ff;
            font-size: 14px;
            pointer-events: none;
        }
        .form-input {
            width: 100%;
            height: 48px;
            padding: 0 42px 0 42px;
            background: #050811;
            border: 1.5px solid rgba(0, 240, 255, 0.35);
            border-radius: 12px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            font-family: 'Rajdhani', sans-serif;
            transition: all 0.2s ease;
        }
        .form-input:focus {
            outline: none;
            border-color: #00f0ff;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.45);
        }
        .form-input::placeholder {
            color: #475569;
        }
        .btn-eye {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 6px;
            font-size: 14px;
            transition: color 0.2s;
        }
        .btn-eye:hover {
            color: #00f0ff;
        }
        .credentials-box {
            background: rgba(0, 240, 255, 0.06);
            border: 1px solid rgba(0, 240, 255, 0.25);
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .cred-title {
            color: #00f0ff;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .cred-value {
            color: #e2e8f0;
            font-family: monospace;
            font-size: 11px;
            font-weight: 600;
            margin-top: 3px;
            user-select: all;
        }
        .btn-autofill {
            background: #00f0ff;
            color: #050811;
            font-weight: 800;
            font-size: 11px;
            padding: 6px 12px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-autofill:hover {
            box-shadow: 0 0 12px #00f0ff;
            transform: translateY(-1px);
        }
        .form-extra {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
            font-size: 12px;
        }
        .remember-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #94a3b8;
            cursor: pointer;
        }
        .remember-wrap input {
            accent-color: #00f0ff;
            width: 16px;
            height: 16px;
        }
        .link-user-login {
            color: #00f0ff;
            text-decoration: none;
            font-weight: 600;
        }
        .link-user-login:hover {
            text-decoration: underline;
        }
        .btn-submit {
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, #00f0ff 0%, #0080ff 100%);
            color: #050811;
            font-family: 'Orbitron', sans-serif;
            font-weight: 900;
            font-size: 14px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.45);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .btn-submit:hover {
            box-shadow: 0 0 35px rgba(0, 240, 255, 0.75);
            transform: translateY(-2px);
        }
        .return-link-wrap {
            text-align: center;
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }
        .return-link {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: color 0.2s;
        }
        .return-link:hover {
            color: #00f0ff;
        }
        .footer-note {
            text-align: center;
            color: #475569;
            font-size: 12px;
            margin-top: 20px;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Brand Header -->
        <div class="brand-header">
            <div class="brand-icon">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h1 class="brand-title"><%= settings.site_name %></h1>
            <p class="brand-sub">Administrative Control Panel</p>
        </div>

        <!-- Login Card -->
        <div class="login-card">
            <% if (error) { %>
            <div class="alert-error">
                <i class="fas fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
            <% } %>

            <form action="/admin/login" method="POST" id="adminLoginForm">
                <div class="form-group">
                    <label for="email" class="form-label">Email Address</label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope input-icon"></i>
                        <input id="email" name="email" type="email" autocomplete="email" required
                               value="<%= defaultEmail || 'tgsgaming2024@gmail.com' %>"
                               placeholder="tgsgaming2024@gmail.com"
                               class="form-input">
                    </div>
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input id="password" name="password" type="password" autocomplete="current-password" required
                               value="<%= defaultPassword || 'Toqy+thamid2026' %>"
                               placeholder="••••••••••••"
                               class="form-input">
                        <button type="button" onclick="togglePasswordVisibility()" class="btn-eye" title="Toggle password visibility">
                            <i id="toggleEye" class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Default Credentials Card -->
                <div class="credentials-box">
                    <div>
                        <div class="cred-title"><i class="fas fa-key"></i> Default Credentials:</div>
                        <div class="cred-value">tgsgaming2024@gmail.com | Toqy+thamid2026</div>
                    </div>
                    <button type="button" onclick="fillCredentials()" class="btn-autofill">
                        Auto Fill
                    </button>
                </div>

                <div class="form-extra">
                    <label class="remember-wrap">
                        <input id="remember" name="remember" type="checkbox" checked>
                        <span>Remember session</span>
                    </label>
                    <a href="/login" class="link-user-login">User Login</a>
                </div>

                <button type="submit" id="btnAdminSubmit" class="btn-submit">
                    <span>Sign In to Dashboard</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>

            <div class="return-link-wrap">
                <a href="/" class="return-link">
                    <i class="fas fa-arrow-left"></i> Return to Public Store
                </a>
            </div>
        </div>

        <div class="footer-note">
            Powered by Panel Sell Engine &bull; Cyberpunk Admin Portal
        </div>
    </div>

    <script>
    function togglePasswordVisibility() {
        var pwd = document.getElementById('password');
        var eye = document.getElementById('toggleEye');
        if (pwd.type === 'password') {
            pwd.type = 'text';
            eye.classList.remove('fa-eye');
            eye.classList.add('fa-eye-slash');
        } else {
            pwd.type = 'password';
            eye.classList.remove('fa-eye-slash');
            eye.classList.add('fa-eye');
        }
    }

    function fillCredentials() {
        document.getElementById('email').value = 'tgsgaming2024@gmail.com';
        document.getElementById('password').value = 'Toqy+thamid2026';
    }
    </script>
</body>
</html>
