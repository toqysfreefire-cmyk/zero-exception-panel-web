    </div>

    <!-- Modal: Bulk Add Keys -->
    <div class="modal fade" id="bulkAddKeyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-gray-900 border border-gray-800 text-white rounded-2xl shadow-2xl">
                <div class="modal-header border-b border-gray-800 py-3 px-5">
                    <h5 class="font-bold text-white text-base flex items-center gap-2">
                        <i class="fas fa-file-import text-purple-400"></i> Bulk Import Product Keys
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/admin/keys/bulk-add" method="POST">
                    <div class="modal-body p-5 space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Target Product *</label>
                            <select name="product_id" required class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                                <% products.forEach(function(p) { %>
                                <option value="<%= p.id %>"><%= p.title %> (<%= p.category %>)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Plan / Variant Duration *</label>
                            <select name="variant" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                                <option value="1 Day Key">1 Day Key</option>
                                <option value="7 Days Key">7 Days Key</option>
                                <option value="30 Days Key">30 Days Key</option>
                                <option value="Lifetime Key">Lifetime Key</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Paste Keys (One Per Line) *</label>
                            <textarea name="bulk_keys" rows="6" required placeholder="KEY-1234-5678&#10;KEY-9876-5432&#10;KEY-5555-4444" class="w-full px-3 py-2 bg-gray-900 border border-cyan-500/40 rounded-lg text-white text-xs font-mono"></textarea>
                            <small class="text-[11px] text-gray-400 block mt-1">Each non-empty line will be registered as an individual active key.</small>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Batch Note (Optional)</label>
                            <input type="text" name="notes" placeholder="e.g. Supplier Telegram Batch" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                        </div>
                    </div>
                    <div class="modal-footer border-t border-gray-800 py-3 px-5">
                        <button type="button" class="btn btn-secondary text-xs rounded-lg" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success text-xs font-black rounded-lg px-5 py-2.5">
                            <i class="fas fa-file-import me-1"></i> Import Keys
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Edit Key -->
    <div class="modal fade" id="editKeyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-gray-900 border border-gray-800 text-white rounded-2xl shadow-2xl">
                <div class="modal-header border-b border-gray-800 py-3 px-5">
                    <h5 class="font-bold text-white text-base flex items-center gap-2">
                        <i class="fas fa-pen text-amber-400"></i> Edit Product Key (<span id="edit_key_id_display" class="font-mono text-cyan-400"></span>)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editKeyForm" method="POST">
                    <div class="modal-body p-5 space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Product</label>
                            <select id="edit_key_product_id" name="product_id" required class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                                <% products.forEach(function(p) { %>
                                <option value="<%= p.id %>"><%= p.title %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Plan / Variant Duration</label>
                            <input type="text" id="edit_key_variant" name="variant" required class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">License Key String *</label>
                            <input type="text" id="edit_key_license_key" name="license_key" required class="w-full px-3 py-2 bg-gray-900 border border-cyan-500/40 rounded-lg text-white text-sm font-mono font-bold">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Status</label>
                                <select id="edit_key_status" name="status" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                                    <option value="available">Available (In Stock)</option>
                                    <option value="used">Used (Assigned)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Assigned Order ID</label>
                                <input type="text" id="edit_key_order_id" name="assigned_order_id" placeholder="ORD-xxxxx" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm font-mono">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Assigned Customer / UID</label>
                            <input type="text" id="edit_key_assigned_to" name="assigned_to" placeholder="Player UID or WhatsApp" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Notes</label>
                            <input type="text" id="edit_key_notes" name="notes" class="w-full px-3 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white text-sm">
                        </div>
                    </div>
                    <div class="modal-footer border-t border-gray-800 py-3 px-5">
                        <button type="button" class="btn btn-secondary text-xs rounded-lg" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success text-xs font-black rounded-lg px-5 py-2.5">
                            <i class="fas fa-save me-1"></i> Update Key
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Assign Key to Order -->
    <div class="modal fade" id="assignKeyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-gray-900 border border-gray-800 text-white rounded-2xl shadow-2xl">
                <div class="modal-header border-b border-gray-800 py-3 px-5">
                    <h5 class="font-bold text-white text-base flex items-center gap-2">
                        <i class="fas fa-link text-cyan-400"></i> Assign Key to Order (<span id="assign_order_id_display" class="font-mono text-cyan-400"></span>)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="assignKeyForm" method="POST">
                    <div class="modal-body p-5 space-y-4">
                        <div class="p-3 bg-cyan-950/40 rounded-xl border border-cyan-500/30 text-xs text-cyan-200">
                            <div>Order Item: <strong id="assign_order_product_name" class="text-white"></strong></div>
                            <div>Tier / Plan: <strong id="assign_order_variant" class="text-yellow-300"></strong></div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Option A: Select from Available Stock</label>
                            <select id="assign_select_key_id" name="selected_key_id" class="w-full px-3 py-2 bg-gray-900 border border-cyan-500/30 rounded-lg text-white text-sm">
                                <option value="">-- Choose matching in-stock key --</option>
                            </select>
                            <small class="text-[11px] text-gray-400 mt-1 block">Keys matching this product in inventory.</small>
                        </div>

                        <div class="text-center text-xs font-bold text-gray-500 uppercase">— OR —</div>

                        <div>
                            <label class="block text-xs font-bold text-cyan-400 uppercase mb-1">Option B: Enter / Generate Custom Key</label>
                            <input type="text" id="assign_key_input" name="key_input" placeholder="Type or paste license key directly..." class="w-full px-3 py-2 bg-gray-900 border border-cyan-500/30 rounded-lg text-white text-sm font-mono font-bold">
                            <small class="text-[11px] text-gray-400 mt-1 block">If entered, this key will be assigned to the buyer and added to inventory.</small>
                        </div>
                    </div>
                    <div class="modal-footer border-t border-gray-800 py-3 px-5">
                        <button type="button" class="btn btn-secondary text-xs rounded-lg" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success text-xs font-black rounded-lg px-5 py-2.5">
                            <i class="fas fa-check me-1"></i> Assign Key &amp; Deliver
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="/assets/js/bootstrap.bundle.min.js"></script>

    <script>
    // Tab switching
    function switchTab(tabId, el) {
        document.querySelectorAll('.admin-tab-pane').forEach(function(pane) {
            pane.style.display = 'none';
        });
        document.querySelectorAll('.sidebar-link').forEach(function(link) {
            link.classList.remove('active');
        });

        var targetPane = document.getElementById('tab-' + tabId);
        if (targetPane) {
            targetPane.style.display = 'block';
        }
        if (el) {
            el.classList.add('active');
        }
    }

    // Filter Admin Products
    function filterAdminProducts() {
        var input = document.getElementById('adminProductSearch');
        var filter = input.value.toLowerCase();
        var rows = document.querySelectorAll('.product-row');
        rows.forEach(function(row) {
            var name = row.getAttribute('data-name') || '';
            row.style.display = name.includes(filter) ? '' : 'none';
        });
    }

    // Modal controls
    function openAddProductModal() {
        updateDurationEditor('add');
        var modal = new bootstrap.Modal(document.getElementById('addProductModal'));
        modal.show();
    }

    function openAddSliderModal() {
        var modal = new bootstrap.Modal(document.getElementById('addSliderModal'));
        modal.show();
    }

    function openEditProductModal(product) {
        document.getElementById('editProductForm').action = '/admin/products/edit/' + product.id;
        document.getElementById('edit_title').value = product.title || '';
        document.getElementById('edit_category').value = product.category || 'non-root';
        updateDurationEditor('edit');
        document.getElementById('edit_price').value = product.price || 0;
        document.getElementById('edit_discount').value = product.discount || '';
        document.getElementById('edit_is_maintenance').value = product.is_maintenance ? '1' : '0';
        document.getElementById('edit_image').value = product.image || '';
        document.getElementById('edit_setup_url').value = product.setup_url || '';
        document.getElementById('edit_apk_url').value = product.apk_url || '';
        document.getElementById('edit_feedback_url').value = product.feedback_url || '';
        document.getElementById('edit_maintenance_message').value = product.maintenance_message || '';
        document.getElementById('edit_supported_phones').value = product.supported_phones || '';
        document.getElementById('edit_description').value = product.description || '';

        var durationOptions = product.duration_options || '';
        if (Array.isArray(durationOptions)) {
            durationOptions = durationOptions.map(function(option) {
                var price = option.price;
                if (price === undefined) {
                    price = Math.round((Number(product.price) || 0) * (Number(option.multiplier || option.value) || 1));
                }
                return option.days ? option.days + '|' + price : (option.label || option.name || option.title || option.variant || '') + '|' + price;
            }).join('\n');
        } else if (typeof durationOptions !== 'string') {
            durationOptions = '';
        }
        document.getElementById('edit_duration_options').value = durationOptions;

        var modal = new bootstrap.Modal(document.getElementById('editProductModal'));
        modal.show();
    }

    function updateDurationEditor(prefix) {
        var categorySelect = document.getElementById(prefix + '_category');
        var label = document.getElementById(prefix + '_duration_options_label');
        var help = document.getElementById(prefix + '_duration_options_help');
        var textarea = document.getElementById(prefix + '_duration_options');
        if (!categorySelect || !label || !help || !textarea) return;

        var isRootService = categorySelect.value === 'root-service';
        label.textContent = isRootService ? 'Service Plans (Plan Name|Fixed Price)' : 'Durations (Days|Fixed Price)';
        help.textContent = isRootService
            ? 'One plan per line: plan name|fixed price in BDT. Leave blank to use default plans.'
            : 'One duration per line: number of days|fixed price in BDT. Leave blank to use default durations.';
        textarea.placeholder = isRootService
            ? 'Standard Device Rooting|500\nRoot + Gaming Kernel|675'
            : '1|50\n7|200\n30|500';
    }

    document.getElementById('add_category').addEventListener('change', function() {
        updateDurationEditor('add');
    });
    document.getElementById('edit_category').addEventListener('change', function() {
        updateDurationEditor('edit');
    });

    // Pass keys from backend to client JS for assignKeyModal matching
    var allAdminKeys = <%- JSON.stringify(keys) %>;

    // Key Modals
    function openAddKeyModal(productId) {
        if (productId) {
            var select = document.getElementById('add_key_product_id');
            if (select) select.value = productId;
        }
        var modal = new bootstrap.Modal(document.getElementById('addKeyModal'));
        modal.show();
    }

    function openBulkAddKeyModal() {
        var modal = new bootstrap.Modal(document.getElementById('bulkAddKeyModal'));
        modal.show();
    }

    function openEditKeyModal(key) {
        document.getElementById('editKeyForm').action = '/admin/keys/edit/' + key.id;
        document.getElementById('edit_key_id_display').innerText = key.id;
        document.getElementById('edit_key_product_id').value = key.product_id || 1;
        document.getElementById('edit_key_variant').value = key.variant || '1 Day Key';
        document.getElementById('edit_key_license_key').value = key.license_key || '';
        document.getElementById('edit_key_status').value = key.status || 'available';
        document.getElementById('edit_key_order_id').value = key.assigned_order_id || '';
        document.getElementById('edit_key_assigned_to').value = key.assigned_to || '';
        document.getElementById('edit_key_notes').value = key.notes || '';

        var modal = new bootstrap.Modal(document.getElementById('editKeyModal'));
        modal.show();
    }

    function openAssignKeyModal(orderId, prodNameEncoded, prodId, variantEncoded) {
        var prodName = decodeURIComponent(prodNameEncoded || '');
        var variant = decodeURIComponent(variantEncoded || '');

        document.getElementById('assignKeyForm').action = '/admin/orders/assign-key/' + orderId;
        document.getElementById('assign_order_id_display').innerText = orderId;
        document.getElementById('assign_order_product_name').innerText = prodName;
        document.getElementById('assign_order_variant').innerText = variant || 'Standard';
        document.getElementById('assign_key_input').value = '';

        // Populate dropdown with available keys for this product
        var select = document.getElementById('assign_select_key_id');
        select.innerHTML = '<option value="">-- Choose matching in-stock key --</option>';

        var matchingKeys = allAdminKeys.filter(function(k) {
            return k.status === 'available' && (k.product_id === prodId || (k.product_title && k.product_title.toLowerCase() === prodName.toLowerCase()));
        });

        if (matchingKeys.length === 0) {
            var opt = document.createElement('option');
            opt.disabled = true;
            opt.innerText = 'No available keys in stock for this product (Use Option B below)';
            select.appendChild(opt);
        } else {
            matchingKeys.forEach(function(k) {
                var opt = document.createElement('option');
                opt.value = k.id;
                opt.innerText = k.license_key + ' (' + (k.variant || 'Standard') + ' - ' + k.id + ')';
                select.appendChild(opt);
            });
        }

        var modal = new bootstrap.Modal(document.getElementById('assignKeyModal'));
        modal.show();
    }

    // Filter Keys
    function filterAdminKeys() {
        var search = (document.getElementById('adminKeySearch').value || '').toLowerCase().trim();
        var statusFilter = (document.getElementById('adminKeyStatusFilter').value || '').toLowerCase().trim();
        var productFilter = (document.getElementById('adminKeyProductFilter').value || '').trim();

        var rows = document.querySelectorAll('.key-row');
        var visibleCount = 0;

        rows.forEach(function(row) {
            var keyStr = row.getAttribute('data-key') || '';
            var prodId = row.getAttribute('data-product-id') || '';
            var prodName = row.getAttribute('data-product-name') || '';
            var status = row.getAttribute('data-status') || '';
            var orderId = row.getAttribute('data-order') || '';

            var matchesSearch = !search || keyStr.includes(search) || prodName.includes(search) || orderId.includes(search);
            var matchesStatus = !statusFilter || status === statusFilter;
            var matchesProduct = !productFilter || prodId === productFilter;

            if (matchesSearch && matchesStatus && matchesProduct) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        var countDisplay = document.getElementById('visibleKeyCount');
        if (countDisplay) countDisplay.innerText = visibleCount;
    }

    // Auto tab switch based on URL hash
    window.addEventListener('DOMContentLoaded', function() {
        var hash = window.location.hash.replace('#', '');
        if (hash) {
            var targetLink = document.querySelector('.sidebar-link[href="#' + hash + '"]');
            if (targetLink) {
                switchTab(hash, targetLink);
            }
        }
    });

    // Mobile sidebar toggle
    var mobileBtn = document.getElementById('mobileMenuBtn');
    var sidebar = document.getElementById('sidebar');
    if (mobileBtn && sidebar) {
        mobileBtn.addEventListener('click', function() {
            sidebar.classList.toggle('hidden');
        });
    }
    </script>
</body>
</html>
